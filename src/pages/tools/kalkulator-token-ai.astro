---
// src/pages/tools/kalkulator-token-ai.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Kalkulator Biaya Token API AI (OpenAI GPT-4o, Claude 3.7, Gemini) | Helmi Irfansah Tools";
const pageDesc = "Kalkulator biaya API Token AI interaktif gratis dalam Rupiah (IDR). Hitung dan bandingkan estimasi pengeluaran bulanan model LLM OpenAI GPT-4o, Claude 3.7 Sonnet, Claude 3.5 Haiku, Gemini 2.5 Flash, dan Gemini 2.5 Pro.";
const pageCanonical = "https://helmirfansah.com/tools/kalkulator-token-ai";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://helmirfansah.com/tools/kalkulator-token-ai#app",
      "name": "Kalkulator Biaya Token API AI",
      "url": pageCanonical,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "IDR"
      },
      "description": pageDesc,
      "author": {
        "@type": "Person",
        "name": "Helmi Irfansah",
        "url": "https://helmirfansah.com"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://helmirfansah.com/tools/kalkulator-token-ai#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Bagaimana cara menghitung estimasi kebutuhan token API AI?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1 token setara dengan sekitar 3-4 karakter teks. Kalikan estimasi token input dan output per panggilan dengan volume request harian Anda, lalu kalikan tarif per 1 juta token masing-masing model."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana cara memangkas biaya API token hingga 70%?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Gunakan teknik model routing (menggunakan Gemini 2.5 Flash atau Claude 3.5 Haiku untuk tugas ringan), aktifkan prompt caching untuk prompt sistem yang berulang, dan lakukan token pruning pada riwayat chat."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical={pageCanonical}
  schema={schema}
>
  <main id="main-content" style="padding-top: 2rem; padding-bottom: 5rem;">
    
    <!-- ── BREADCRUMB & HERO ── -->
    <section style="max-width: var(--max-w); margin: 0 auto; padding: 1.5rem 1.5rem 1rem;">
      <nav aria-label="Breadcrumb" style="font-size: 0.825rem; color: var(--ink-muted); margin-bottom: 0.75rem;">
        <a href="/" style="color: var(--ink-muted);">Beranda</a> &rsaquo; 
        <a href="/tools" style="color: var(--ink-muted);">Tools</a> &rsaquo; 
        <span style="color: var(--accent-clay); font-weight: 600;">Kalkulator Token AI</span>
      </nav>

      <!-- Topic Switcher Pills -->
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
        <a href="/tools/kalkulator-affiliate" style="font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.6rem; border-radius: 999px; background: var(--bg-alt); border: 1px solid var(--border); color: var(--ink-secondary);">
          💰 Komisi Afiliasi &rarr;
        </a>
        <a href="/tools/kalkulator-engagement-rate" style="font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.6rem; border-radius: 999px; background: var(--bg-alt); border: 1px solid var(--border); color: var(--ink-secondary);">
          📊 ER &amp; Rate Card Medsos &rarr;
        </a>
        <a href="/tools/kalkulator-cloud-vps" style="font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.6rem; border-radius: 999px; background: var(--bg-alt); border: 1px solid var(--border); color: var(--ink-secondary);">
          ☁️ Cloud VPS Server &rarr;
        </a>
        <span style="font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 999px; background: var(--accent-clay); color: #fff;">
          🤖 Token API AI (Aktif)
        </span>
      </div>

      <h1 style="font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.15; color: var(--ink); margin-bottom: 0.75rem;">
        Kalkulator Biaya <em style="font-style: italic; color: var(--accent-clay);">API Token AI</em> (IDR)
      </h1>
      <p style="font-size: 1.05rem; color: var(--ink-secondary); max-width: 760px; line-height: 1.6; margin-bottom: 1.5rem;">
        Simulasikan pengeluaran harian dan bulanan penggunaan model LLM populer (OpenAI GPT-4o, Claude 3.7 Sonnet, Gemini 2.5 Flash) dalam Rupiah berdasarkan volume input dan output token.
      </p>
    </section>

    <!-- ── CALCULATOR CONTAINER ── -->
    <section style="max-width: var(--max-w); margin: 0 auto; padding: 0 1.5rem 3rem;">
      <div class="calc-container" style="box-shadow: var(--shadow-sm); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; background: var(--bg-card);">
        
        <div class="calc-header" style="border-bottom: 1px solid var(--border); padding: 1.25rem 1.5rem; background: var(--bg-alt); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
          <div>
            <h2 style="font-family: var(--font-serif); font-size: 1.3rem; font-weight: 500; color: var(--ink); margin: 0 0 0.25rem;">
              Simulasi Volume Token AI
            </h2>
            <p style="font-size: 0.85rem; color: var(--ink-muted); margin: 0;">
              Geser tuas token input dan output harian untuk menghitung estimasi biaya aktif 30 hari.
            </p>
          </div>
          <a href="/tools" class="btn-ghost" style="font-size: 0.8rem; padding: 0.4rem 0.85rem;">
            ← Semua Tools &amp; Hub
          </a>
        </div>

        <div class="calc-body" style="padding: 1.5rem;">
          <div class="calc-inputs" style="background: var(--bg-alt); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border); display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="tokens-in" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Input Tokens / hari:</label>
                <strong id="tokens-in-val" style="font-family: var(--font-mono); color: var(--accent-clay);">500K token</strong>
              </div>
              <input type="range" id="tokens-in" min="10" max="5000" value="500" step="10" aria-label="Input Tokens per hari">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Prompt + instruksi + konteks riwayat chat.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="tokens-out" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Output Tokens / hari:</label>
                <strong id="tokens-out-val" style="font-family: var(--font-mono); color: var(--accent-clay);">200K token</strong>
              </div>
              <input type="range" id="tokens-out" min="10" max="2000" value="200" step="10" aria-label="Output Tokens per hari">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Jawaban atau teks yang digenerate oleh model.</span>
            </div>
          </div>

          <div style="margin-top: 1.5rem;">
            <div class="calc-results" id="ai-results">
              <!-- Rendered via JS -->
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── SEO ARTICLE & TIPS ── -->
    <section style="max-width: var(--max-w); margin: 0 auto; padding: 2rem 1.5rem; border-top: 1px solid var(--border);">
      <div class="section-label">STRATEGI EFISIENSI AI</div>
      <h2 style="font-family: var(--font-serif); font-size: 1.75rem; color: var(--ink); margin-bottom: 1rem;">
        3 Trik Menghemat Pengeluaran Token API hingga 70%
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">
        <div style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.25rem; border-radius: var(--radius-sm);">
          <h3 style="font-size: 1rem; color: var(--ink); margin-bottom: 0.4rem;">1. Model Routing</h3>
          <p style="font-size: 0.875rem; color: var(--ink-secondary); line-height: 1.6;">
            Gunakan Gemini 2.5 Flash atau Claude 3.5 Haiku untuk klasifikasi, ekstraksi, dan pemformatan data. Panggil model mahal (GPT-4o/Claude 3.7) hanya untuk penalaran rumit.
          </p>
        </div>
        <div style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.25rem; border-radius: var(--radius-sm);">
          <h3 style="font-size: 1rem; color: var(--ink); margin-bottom: 0.4rem;">2. Prompt Caching</h3>
          <p style="font-size: 0.875rem; color: var(--ink-secondary); line-height: 1.6;">
            Manfaatkan fitur cache dari Anthropic dan OpenAI untuk memotong tarif token input hingga 90% pada panggilan berulang dengan prompt sistem yang sama.
          </p>
        </div>
        <div style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.25rem; border-radius: var(--radius-sm);">
          <h3 style="font-size: 1rem; color: var(--ink); margin-bottom: 0.4rem;">3. Semantic Truncation</h3>
          <p style="font-size: 0.875rem; color: var(--ink-secondary); line-height: 1.6;">
            Pangkas tag HTML, whitespace, dan chat lama sebelum diteruskan ke API LLM.
          </p>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
