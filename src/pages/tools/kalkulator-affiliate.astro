---
// src/pages/tools/kalkulator-affiliate.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Kalkulator Komisi Affiliate Marketing (Shopee, TikTok, SaaS) | Helmi Irfansah Tools";
const pageDesc = "Kalkulator komisi affiliate marketing interaktif gratis. Hitung estimasi penghasilan Shopee Affiliate, TikTok Shop, produk digital SaaS, dan Web3 referral berdasarkan views, CTR, CVR, dan harga produk.";
const pageCanonical = "https://helmirfansah.com/tools/kalkulator-affiliate";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://helmirfansah.com/tools/kalkulator-affiliate#app",
      "name": "Kalkulator Komisi Affiliate Marketing",
      "url": pageCanonical,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "IDR"
      },
      "description": pageDesc,
      "author": {
        "@type": "Person",
        "name": "Helmi Irfansah",
        "url": "https://helmirfansah.com"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://helmirfansah.com/tools/kalkulator-affiliate#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Bagaimana rumus menghitung komisi affiliate marketing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rumus komisi affiliate adalah: Penghasilan = Total Views × CTR Link (%) × CVR Pembelian (%) × Rata-rata Harga Produk (AOV) × Persentase Komisi (%)."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa rata-rata komisi Shopee Affiliate dan TikTok Shop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Shopee Affiliate rata-rata memberikan komisi 5% - 10% untuk produk fisik marketplace (maksimal cap per item berlaku tergantung kategori). TikTok Shop Affiliate berkisar antara 7% - 15%, dengan beberapa toko memberikan komisi ekstra hingga 20% bagi kreator berkinerja tinggi."
          }
        },
        {
          "@type": "Question",
          "name": "Apa yang dimaksud dengan EPC (Earnings Per Click) dalam afiliasi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "EPC adalah rata-rata penghasilan yang Anda peroleh untuk setiap satu klik pada link afiliasi Anda. EPC dihitung dari: Total Komisi ÷ Total Klik Link."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical={pageCanonical}
  schema={schema}
>
  <main id="main-content" style="padding-top: 2rem; padding-bottom: 5rem;">
    
    <!-- ── BREADCRUMB & HERO ── -->
    <section style="max-width: var(--max-w); margin: 0 auto; padding: 1.5rem 1.5rem 1rem;">
      <nav aria-label="Breadcrumb" style="font-size: 0.825rem; color: var(--ink-muted); margin-bottom: 0.75rem;">
        <a href="/" style="color: var(--ink-muted);">Beranda</a> &rsaquo; 
        <a href="/tools" style="color: var(--ink-muted);">Tools</a> &rsaquo; 
        <span style="color: var(--accent-clay); font-weight: 600;">Kalkulator Affiliate</span>
      </nav>

      <!-- Topic Switcher Pills -->
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
        <span style="font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 999px; background: var(--accent-clay); color: #fff;">
          💰 Komisi Afiliasi (Aktif)
        </span>
        <a href="/tools/kalkulator-engagement-rate" style="font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.6rem; border-radius: 999px; background: var(--bg-alt); border: 1px solid var(--border); color: var(--ink-secondary);">
          📊 ER &amp; Rate Card Medsos &rarr;
        </a>
        <a href="/tools/kalkulator-cloud-vps" style="font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.6rem; border-radius: 999px; background: var(--bg-alt); border: 1px solid var(--border); color: var(--ink-secondary);">
          ☁️ Cloud VPS Server &rarr;
        </a>
        <a href="/tools/kalkulator-token-ai" style="font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.6rem; border-radius: 999px; background: var(--bg-alt); border: 1px solid var(--border); color: var(--ink-secondary);">
          🤖 Token API AI &rarr;
        </a>
      </div>

      <h1 style="font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.15; color: var(--ink); margin-bottom: 0.75rem;">
        Kalkulator Komisi <em style="font-style: italic; color: var(--accent-clay);">Affiliate Marketing</em>
      </h1>
      <p style="font-size: 1.05rem; color: var(--ink-secondary); max-width: 760px; line-height: 1.6; margin-bottom: 1.5rem;">
        Simulasikan proyeksi penghasilan bersih affiliate Shopee, TikTok Shop, SaaS, dan Web3. Hitung estimasi cuan per bulan, total GMV omset penjualan, EPC (Earnings Per Click), dan RPM dari traffic konten Anda.
      </p>
    </section>

    <!-- ── CALCULATOR CONTAINER ── -->
    <section style="max-width: var(--max-w); margin: 0 auto; padding: 0 1.5rem 3rem;">
      <div class="calc-container" style="box-shadow: var(--shadow-sm); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; background: var(--bg-card);">
        
        <div class="calc-header" style="border-bottom: 1px solid var(--border); padding: 1.25rem 1.5rem; background: var(--bg-alt); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
          <div>
            <h2 style="font-family: var(--font-serif); font-size: 1.3rem; font-weight: 500; color: var(--ink); margin: 0 0 0.25rem;">
              Simulasi Pendapatan Afiliasi
            </h2>
            <p style="font-size: 0.85rem; color: var(--ink-muted); margin: 0;">
              Geser tuas di bawah untuk menguji skenario views, rasio klik (CTR), dan tingkat konversi (CVR).
            </p>
          </div>
          <a href="/tools" class="btn-ghost" style="font-size: 0.8rem; padding: 0.4rem 0.85rem;">
            ← Semua Tools &amp; Hub
          </a>
        </div>

        <div class="calc-body" style="padding: 1.5rem;">
          <!-- Preset Buttons -->
          <div style="margin-bottom: 1.25rem; display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
            <span style="font-size: 0.8rem; font-weight: 600; color: var(--ink-muted); margin-right: 0.25rem;">Pilih Preset Cepat:</span>
            <button type="button" class="aff-preset-btn active" data-preset="shopee" style="font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid var(--border-strong); background: var(--bg); color: var(--ink); cursor: pointer;">
              🛍️ Shopee (7%)
            </button>
            <button type="button" class="aff-preset-btn" data-preset="tiktok" style="font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid var(--border-strong); background: var(--bg); color: var(--ink); cursor: pointer;">
              🎵 TikTok Shop (12%)
            </button>
            <button type="button" class="aff-preset-btn" data-preset="saas" style="font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid var(--border-strong); background: var(--bg); color: var(--ink); cursor: pointer;">
              💻 SaaS / Digital (35%)
            </button>
            <button type="button" class="aff-preset-btn" data-preset="web3" style="font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid var(--border-strong); background: var(--bg); color: var(--ink); cursor: pointer;">
              ⚡ Web3 Referral (25%)
            </button>
          </div>

          <div class="calc-inputs" style="background: var(--bg-alt); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border); display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
            
            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="aff-views" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Estimasi Views / Traffic:</label>
                <strong id="aff-views-val" style="font-family: var(--font-mono); color: var(--accent-clay);">60.000 Views</strong>
              </div>
              <input type="range" id="aff-views" min="1000" max="1000000" value="60000" step="1000" aria-label="Views Bulanan">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Total tayangan video atau pembaca konten per bulan.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="aff-ctr" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Click-Through Rate (CTR):</label>
                <strong id="aff-ctr-val" style="font-family: var(--font-mono); color: var(--accent-clay);">4.0%</strong>
              </div>
              <input type="range" id="aff-ctr" min="0.5" max="20" value="4.0" step="0.1" aria-label="CTR Klik Link">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Persentase audiens yang mengklik link bio/keranjang.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="aff-cvr" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Conversion Rate (CVR):</label>
                <strong id="aff-cvr-val" style="font-family: var(--font-mono); color: var(--accent-clay);">2.5%</strong>
              </div>
              <input type="range" id="aff-cvr" min="0.5" max="15" value="2.5" step="0.1" aria-label="Tingkat Konversi Pembelian">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Persentase klik yang checkout dan berhasil bayar.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="aff-price" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Rata-rata Harga Produk (AOV):</label>
                <strong id="aff-price-val" style="font-family: var(--font-mono); color: var(--accent-clay);">Rp 125.000</strong>
              </div>
              <input type="range" id="aff-price" min="10000" max="2000000" value="125000" step="5000" aria-label="Harga Rata-rata Produk">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Nilai keranjang belanja rata-rata per transaksi.</span>
            </div>

            <div class="input-group" style="grid-column: 1 / -1;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="aff-comm" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Persentase Komisi Afiliasi:</label>
                <strong id="aff-comm-val" style="font-family: var(--font-mono); color: var(--accent-clay);">7.0%</strong>
              </div>
              <input type="range" id="aff-comm" min="1" max="50" value="7.0" step="0.5" aria-label="Persentase Komisi">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Fisik/E-commerce: 5%-15% | Digital/Web3: 20%-50%.</span>
            </div>

          </div>

          <div style="margin-top: 1.5rem;">
            <div class="calc-results" id="affiliate-results">
              <!-- Rendered via JS -->
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── SEO ARTICLE & GUIDE ── -->
    <section style="max-width: var(--max-w); margin: 0 auto; padding: 2rem 1.5rem; border-top: 1px solid var(--border);">
      <div class="section-label">PANDUAN EKSEKUTIF</div>
      <h2 style="font-family: var(--font-serif); font-size: 1.75rem; color: var(--ink); margin-bottom: 1rem;">
        Cara Memaksimalkan Cuan Affiliate Tanpa Menambah Followers
      </h2>
      <p style="color: var(--ink-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
        Banyak affiliate terjebak membuat konten yang sekadar mengejar jutaan views, namun hasil komisinya sangat kecil karena rendahnya relevansi audiens. Kunci konversi tinggi terletak pada pembentukan niat beli (<em>buying intent</em>).
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 1.5rem;">
        <div style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.25rem; border-radius: var(--radius-sm);">
          <h3 style="font-size: 1.05rem; color: var(--ink); margin-bottom: 0.5rem;">Fokus Masalah Spesifik</h3>
          <p style="font-size: 0.875rem; color: var(--ink-secondary); line-height: 1.6;">
            Jangan hanya memamerkan produk. Tunjukkan masalah menyebalkan yang dialami penonton, lalu perkenalkan produk sebagai solusi instan terbaik.
          </p>
        </div>
        <div style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.25rem; border-radius: var(--radius-sm);">
          <h3 style="font-size: 1.05rem; color: var(--ink); margin-bottom: 0.5rem;">Optimasi Hook 3 Detik Pertama</h3>
          <p style="font-size: 0.875rem; color: var(--ink-secondary); line-height: 1.6;">
            Gunakan visual demonstration atau pernyataan berani di detik awal video TikTok/Reels agar penonton tidak langsung swipe away.
          </p>
        </div>
        <div style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.25rem; border-radius: var(--radius-sm);">
          <h3 style="font-size: 1.05rem; color: var(--ink); margin-bottom: 0.5rem;">Kombinasi High-Ticket &amp; Recurring</h3>
          <p style="font-size: 0.875rem; color: var(--ink-secondary); line-height: 1.6;">
            Sertakan produk bernilai tinggi atau langganan SaaS dan Web3 referral yang memberikan komisi berulang (recurring commission) tiap bulan.
          </p>
        </div>
      </div>
    </section>

    <!-- ── DEDICATED FAQ ── -->
    <section style="max-width: var(--max-w); margin: 0 auto; padding: 2rem 1.5rem; border-top: 1px solid var(--border);">
      <div class="section-label">FAQ AFILIASI</div>
      <h2 style="font-family: var(--font-serif); font-size: 1.75rem; color: var(--ink); margin-bottom: 1.5rem;">
        Pertanyaan Umum Seputar Penghasilan Affiliate
      </h2>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <details style="background: var(--bg-card); border: 1px solid var(--border); padding: 1rem 1.25rem; border-radius: var(--radius-sm); cursor: pointer;" open>
          <summary style="font-weight: 600; color: var(--ink); font-size: 1rem; outline: none;">
            Bagaimana rumus menghitung komisi affiliate marketing?
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.925rem; color: var(--ink-secondary); line-height: 1.6;">
            Rumus komisi affiliate adalah: Penghasilan = Total Views × CTR Link (%) × CVR Pembelian (%) × Rata-rata Harga Produk (AOV) × Persentase Komisi (%).
          </p>
        </details>
        <details style="background: var(--bg-card); border: 1px solid var(--border); padding: 1rem 1.25rem; border-radius: var(--radius-sm); cursor: pointer;">
          <summary style="font-weight: 600; color: var(--ink); font-size: 1rem; outline: none;">
            Berapa rata-rata komisi Shopee Affiliate dan TikTok Shop?
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.925rem; color: var(--ink-secondary); line-height: 1.6;">
            Shopee Affiliate rata-rata memberikan komisi 5% - 10% untuk produk fisik marketplace. TikTok Shop Affiliate berkisar antara 7% - 15%, dengan beberapa toko memberikan komisi ekstra hingga 20% bagi kreator berkinerja tinggi.
          </p>
        </details>
        <details style="background: var(--bg-card); border: 1px solid var(--border); padding: 1rem 1.25rem; border-radius: var(--radius-sm); cursor: pointer;">
          <summary style="font-weight: 600; color: var(--ink); font-size: 1rem; outline: none;">
            Apa yang dimaksud dengan EPC (Earnings Per Click) dalam afiliasi?
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.925rem; color: var(--ink-secondary); line-height: 1.6;">
            EPC adalah rata-rata penghasilan yang Anda peroleh untuk setiap satu klik pada link afiliasi Anda. EPC dihitung dari: Total Komisi ÷ Total Klik Link.
          </p>
        </details>
      </div>
    </section>

  </main>
</BaseLayout>
