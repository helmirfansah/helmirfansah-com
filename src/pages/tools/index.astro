---
// src/pages/tools/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Kalkulator Biaya Cloud Server & Token AI (IDR) | Helmi Irfansah Tools";
const pageDesc = "Kalkulator interaktif gratis untuk menghitung estimasi biaya server VPS (AWS, DigitalOcean, Biznet Gio, IDCloudHost) dan biaya API Token AI (OpenAI GPT-4o, Claude 3.7, Gemini 2.5 Flash) dalam Rupiah (IDR).";
const pageCanonical = "https://helmirfansah.com/tools";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://helmirfansah.com/tools#app",
      "name": "Kalkulator Biaya Cloud VPS & Token AI",
      "url": "https://helmirfansah.com/tools",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "IDR"
      },
      "description": pageDesc,
      "author": {
        "@type": "Person",
        "name": "Helmi Irfansah",
        "url": "https://helmirfansah.com"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://helmirfansah.com/tools#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Bagaimana cara menghitung estimasi biaya Cloud VPS di Indonesia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Estimasi biaya Cloud VPS dihitung berdasarkan kombinasi 4 variabel utama: jumlah vCPU, kapasitas RAM, penyimpanan NVMe SSD, dan kuota transfer bandwidth keluar (egress). Kalkulator ini mengalikan spesifikasi yang Anda pilih dengan tarif per jam/bulan masing-masing provider dan mengonversinya ke Rupiah (IDR)."
          }
        },
        {
          "@type": "Question",
          "name": "Mengapa provider VPS lokal seperti Biznet Gio dan IDCloudHost seringkali lebih hemat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Provider lokal memiliki data center fisik di Jakarta dengan koneksi langsung ke Indonesia Internet Exchange (IIX). Mereka memberikan kuota bandwidth lokal gratis yang sangat besar (1-2 TB) dan mematok tarif dalam IDR tetap tanpa risiko fluktuasi kurs mata uang USD atau biaya tersembunyi transfer data antar-region."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana cara menghitung kebutuhan token API OpenAI dan Claude?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1 token kira-kira setara dengan 0.75 kata atau 4 karakter dalam bahasa Inggris (dalam bahasa Indonesia sekitar 2-3 karakter per token). Kalikan rata-rata token input dan output per request dengan volume request harian Anda, lalu hitung tarif per 1 juta token sesuai model (misal: GPT-4o, Claude 3.7 Sonnet, atau Gemini 2.5 Flash)."
          }
        },
        {
          "@type": "Question",
          "name": "Apa perbedaan antara token input dan token output pada API LLM?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Token input adalah teks prompt, instruksi sistem, dan riwayat percakapan yang Anda kirimkan ke model. Token output adalah teks respons yang dihasilkan oleh model. Token output biasanya dibanderol dengan harga 3 hingga 5 kali lebih mahal daripada token input karena proses komputasi generasi autoregresif yang lebih berat."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa kurs USD ke IDR yang digunakan pada kalkulator ini?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kalkulator ini menggunakan acuan standar Rp 16.000 per 1 USD yang dapat disesuaikan secara dinamis melalui panel pengaturan admin situs."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical={pageCanonical}
  schema={schema}
>
  <main id="main-content" style="padding-top: 2rem; padding-bottom: 5rem;">
    
    <!-- ── HEADER / HERO ── -->
    <section class="tools-hero" style="max-width: var(--max-w); margin: 0 auto; padding: 2rem 1.5rem 1.5rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
        <span class="section-label" style="margin-bottom: 0;">LAB &amp; TOOLS INTERAKTIF</span>
        <span style="font-size: 11px; padding: 0.2rem 0.5rem; background: var(--bg-alt); border: 1px solid var(--border-strong); border-radius: 999px; color: var(--accent-clay); font-weight: 600;">Update September 2026</span>
      </div>
      
      <h1 style="font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.15; color: var(--ink); margin-bottom: 1rem;">
        Kalkulator Biaya <em style="font-style: italic; color: var(--accent-clay);">Cloud Server</em> &amp; Token AI
      </h1>
      
      <p style="font-size: 1.05rem; color: var(--ink-secondary); max-width: 720px; line-height: 1.6; margin-bottom: 1.75rem;">
        Simulasi komparasi biaya infrastruktur VPS nyata (DigitalOcean, AWS, Vultr, Google Cloud, Biznet Gio, IDCloudHost) dan estimasi tagihan API LLM (OpenAI GPT-4o, Claude 3.7, Gemini 2.5) dalam Rupiah (IDR).
      </p>

      <!-- Quick Nav Buttons -->
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href="#kalkulator" class="btn-primary" style="padding: 0.6rem 1.25rem; font-size: 0.85rem;">
          ⚙️ Buka Kalkulator
        </a>
        <a href="#panduan-vps" class="btn-ghost" style="padding: 0.6rem 1.25rem; font-size: 0.85rem;">
          📖 Panduan Spesifikasi
        </a>
        <a href="#faq" class="btn-ghost" style="padding: 0.6rem 1.25rem; font-size: 0.85rem;">
          ❓ FAQ &amp; Pertanyaan Umum
        </a>
      </div>
    </section>

    <!-- ── CALCULATOR CONTAINER ── -->
    <section id="kalkulator" style="max-width: var(--max-w); margin: 0 auto; padding: 1rem 1.5rem 3rem;">
      <div class="calc-container" id="cloud-calc" style="box-shadow: var(--shadow-sm);">
        <div class="calc-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <div>
            <h2 style="font-family: var(--font-serif); font-size: 1.35rem; font-weight: 500; color: var(--ink); margin-bottom: 0.25rem;">
              Simulasi Biaya Infrastruktur
            </h2>
            <p style="font-size: 0.875rem; color: var(--ink-muted); margin: 0;">
              Geser tuas parameter untuk menghitung estimasi biaya seketika. Kurs acuan: Rp 16.000 / USD.
            </p>
          </div>
          <div class="calc-tabs" role="tablist" aria-label="Pilih Jenis Kalkulator" style="border: none; padding: 0; background: transparent;">
            <button class="calc-tab active" role="tab" aria-selected="true" data-tab="cloud" style="font-weight: 600;">
              ☁️ Cloud VPS (IDR)
            </button>
            <button class="calc-tab" role="tab" aria-selected="false" data-tab="ai" style="font-weight: 600;">
              🤖 Token API AI (IDR)
            </button>
          </div>
        </div>

        <!-- TAB 1: CLOUD CALCULATOR -->
        <div class="calc-body" id="tab-cloud" role="tabpanel">
          <div class="calc-inputs" style="background: var(--bg-alt); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border);">
            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="vcpu" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Processor (vCPU):</label>
                <strong id="vcpu-val" style="font-family: var(--font-mono); color: var(--accent-clay);">4 vCPU</strong>
              </div>
              <input type="range" id="vcpu" min="1" max="32" value="4" step="1" aria-label="Jumlah vCPU">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Rekomendasi: 2-4 vCPU untuk web production standar.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="ram" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Memory (RAM):</label>
                <strong id="ram-val" style="font-family: var(--font-mono); color: var(--accent-clay);">8 GB</strong>
              </div>
              <input type="range" id="ram" min="1" max="128" value="8" step="1" aria-label="Kapasitas RAM">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Ideal: 4-8 GB untuk container Docker/Node.js.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="storage" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">NVMe / SSD Disk:</label>
                <strong id="storage-val" style="font-family: var(--font-mono); color: var(--accent-clay);">100 GB</strong>
              </div>
              <input type="range" id="storage" min="20" max="1000" value="100" step="10" aria-label="Kapasitas Storage">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Penyimpanan cepat berbasis NVMe SSD.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="transfer" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Egress Bandwidth:</label>
                <strong id="transfer-val" style="font-family: var(--font-mono); color: var(--accent-clay);">2 TB</strong>
              </div>
              <input type="range" id="transfer" min="1" max="20" value="2" step="1" aria-label="Bandwidth Transfer">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Trafik keluar bulanan ke pengunjung website.</span>
            </div>
          </div>

          <div style="margin-top: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
              <h3 style="font-size: 1rem; font-weight: 600; color: var(--ink);">Perbandingan Harga per Provider</h3>
              <span style="font-size: 11px; color: var(--ink-muted);">Diurutkan dari yang paling efisien</span>
            </div>
            <div class="calc-results" id="cloud-results">
              <!-- Rendered dynamically by tools.js -->
            </div>
          </div>
        </div>

        <!-- TAB 2: AI CALCULATOR -->
        <div class="calc-body hidden" id="tab-ai" role="tabpanel">
          <div class="calc-inputs" style="background: var(--bg-alt); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border);">
            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="tokens-in" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Input Tokens / hari:</label>
                <strong id="tokens-in-val" style="font-family: var(--font-mono); color: var(--accent-clay);">500K token</strong>
              </div>
              <input type="range" id="tokens-in" min="10" max="5000" value="500" step="10" aria-label="Input Tokens per hari">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Prompt + instruksi + konteks riwayat chat.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="tokens-out" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Output Tokens / hari:</label>
                <strong id="tokens-out-val" style="font-family: var(--font-mono); color: var(--accent-clay);">200K token</strong>
              </div>
              <input type="range" id="tokens-out" min="10" max="2000" value="200" step="10" aria-label="Output Tokens per hari">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Jawaban atau output teks yang dihasilkan AI.</span>
            </div>
          </div>

          <div style="margin-top: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
              <h3 style="font-size: 1rem; font-weight: 600; color: var(--ink);">Estimasi Biaya Model LLM Terpopuler</h3>
              <span style="font-size: 11px; color: var(--ink-muted);">Dihitung untuk 30 hari penggunaan aktif</span>
            </div>
            <div class="calc-results" id="ai-results">
              <!-- Rendered dynamically by tools.js -->
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── SEO SECTION 1: PANDUAN SPESIFIKASI ── -->
    <section id="panduan-vps" style="max-width: var(--max-w); margin: 2rem auto; padding: 2rem 1.5rem; border-top: 1px solid var(--border);">
      <div class="section-label">PANDUAN INFRASTRUKTUR</div>
      <h2 style="font-family: var(--font-serif); font-size: 1.75rem; color: var(--ink); margin-bottom: 1rem;">
        Cara Memilih Spesifikasi VPS yang Tepat untuk Kebutuhan Nyata
      </h2>
      <p style="color: var(--ink-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
        Memilih server untuk aplikasi produksi seringkali menjebak: membeli spek terlalu kecil mengakibatkan <em>Out of Memory (OOM)</em> saat trafik naik mendadak, sementara membeli spek terlalu besar menyia-nyiakan anggaran operasional hingga jutaan rupiah per bulan.
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 1.5rem;">
        <div style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.5rem; border-radius: var(--radius-sm);">
          <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">🌱</div>
          <h3 style="font-size: 1.1rem; color: var(--ink); margin-bottom: 0.5rem;">Starter / Side Project (1 vCPU, 2 GB RAM)</h3>
          <p style="font-size: 0.9rem; color: var(--ink-secondary); line-height: 1.6;">
            Cocok untuk blog pribadi, landing page statis (Astro/Next.js SSG), bot Telegram/WhatsApp ringan, atau API internal ber-trafik di bawah 10.000 pengunjung per bulan.
          </p>
        </div>

        <div style="background: var(--bg-card); border: 1px solid var(--border-strong); padding: 1.5rem; border-radius: var(--radius-sm); position: relative;">
          <span style="position: absolute; top: 1rem; right: 1rem; font-size: 10px; font-weight: 700; background: var(--accent-clay); color: #fff; padding: 0.15rem 0.5rem; border-radius: 4px;">PALING POPULER</span>
          <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">🚀</div>
          <h3 style="font-size: 1.1rem; color: var(--ink); margin-bottom: 0.5rem;">Production Standard (2–4 vCPU, 4–8 GB RAM)</h3>
          <p style="font-size: 0.9rem; color: var(--ink-secondary); line-height: 1.6;">
            Spesifikasi <em>sweet spot</em> untuk startup dan UMKM. Mampu menjalankan multi-container Docker dengan Coolify/Dokku, database PostgreSQL lokal, Redis caching, dan backend Node.js/Go dengan ratusan request per detik.
          </p>
        </div>

        <div style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.5rem; border-radius: var(--radius-sm);">
          <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">🏢</div>
          <h3 style="font-size: 1.1rem; color: var(--ink); margin-bottom: 0.5rem;">Heavy Workload (8+ vCPU, 16+ GB RAM)</h3>
          <p style="font-size: 0.9rem; color: var(--ink-secondary); line-height: 1.6;">
            Dibutuhkan jika Anda menjalankan pemrosesan video/gambar intensif, worker antrean RabbitMQ skala besar, Elasticsearch, atau model AI self-hosted (Ollama/vLLM) di lingkungan CPU.
          </p>
        </div>
      </div>
    </section>

    <!-- ── SEO SECTION 2: LOKAL VS GLOBAL ── -->
    <section style="max-width: var(--max-w); margin: 2rem auto; padding: 2rem 1.5rem; border-top: 1px solid var(--border);">
      <div class="section-label">ANALISIS EMPIRIS</div>
      <h2 style="font-family: var(--font-serif); font-size: 1.75rem; color: var(--ink); margin-bottom: 1rem;">
        Server Lokal Indonesia vs Hyperscaler Global (AWS / GCP / DigitalOcean)
      </h2>
      <p style="color: var(--ink-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
        Berdasarkan hasil pengujian latensi dan audit biaya riil yang sering kami bahas di artikel blog teknis, berikut faktor pertimbangan utama saat memilih lokasi infrastruktur:
      </p>

      <div style="overflow-x: auto; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem; text-align: left;">
          <thead>
            <tr style="border-bottom: 2px solid var(--border); background: var(--bg-alt);">
              <th style="padding: 0.85rem 1rem; color: var(--ink);">Aspek Perbandingan</th>
              <th style="padding: 0.85rem 1rem; color: var(--ink);">Provider Lokal (Biznet / IDCloudHost)</th>
              <th style="padding: 0.85rem 1rem; color: var(--ink);">Provider Global (AWS / DO / GCP)</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: 0.85rem 1rem; font-weight: 600;">Latensi ke User Indonesia</td>
              <td style="padding: 0.85rem 1rem; color: #15803d; font-weight: 600;">Sangat Rendah (5 – 15 ms via IIX)</td>
              <td style="padding: 0.85rem 1rem; color: var(--ink-secondary);">Sedang (25 – 40 ms via Region SG)</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: 0.85rem 1rem; font-weight: 600;">Biaya Transfer Bandwidth (Egress)</td>
              <td style="padding: 0.85rem 1rem; color: #15803d; font-weight: 600;">Gratis kuota besar (1–2 TB / bulan)</td>
              <td style="padding: 0.85rem 1rem; color: #b91c1c;">Mahal di AWS ($0.09/GB setelah kuota habis)</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: 0.85rem 1rem; font-weight: 600;">Mata Uang &amp; Perpajakan</td>
              <td style="padding: 0.85rem 1rem; color: #15803d;">Rupiah IDR tetap + Faktur Pajak PPN 11%</td>
              <td style="padding: 0.85rem 1rem; color: var(--ink-secondary);">USD (Tergantung fluktuasi kurs mata uang)</td>
            </tr>
            <tr>
              <td style="padding: 0.85rem 1rem; font-weight: 600;">Ekosistem Managed Services</td>
              <td style="padding: 0.85rem 1rem; color: var(--ink-secondary);">Terbatas (Fokus IaaS VPS murni)</td>
              <td style="padding: 0.85rem 1rem; color: #15803d; font-weight: 600;">Sangat Lengkap (RDS, S3, SQS, CloudWatch)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── SEO SECTION 3: STRATEGI TOKEN AI ── -->
    <section style="max-width: var(--max-w); margin: 2rem auto; padding: 2rem 1.5rem; border-top: 1px solid var(--border);">
      <div class="section-label">OPTIMASI AI TOOLS</div>
      <h2 style="font-family: var(--font-serif); font-size: 1.75rem; color: var(--ink); margin-bottom: 1rem;">
        3 Strategi Menghemat Biaya Token API AI hingga 70%
      </h2>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">
        <div style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.25rem; border-radius: var(--radius-sm);">
          <h3 style="font-size: 1rem; color: var(--ink); margin-bottom: 0.4rem;">1. Model Routing (Smart Cascading)</h3>
          <p style="font-size: 0.875rem; color: var(--ink-secondary); line-height: 1.6;">
            Jangan gunakan model flagship mahal (GPT-4o / Claude 3.7 Sonnet) untuk semua tugas. Gunakan model hemat seperti <strong>Gemini 2.5 Flash</strong> atau <strong>Claude 3.5 Haiku</strong> untuk klasifikasi teks, ekstraksi data, dan pemformatan. Hanya panggil model besar saat membutuhkan penalaran multi-step kompleks.
          </p>
        </div>

        <div style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.25rem; border-radius: var(--radius-sm);">
          <h3 style="font-size: 1rem; color: var(--ink); margin-bottom: 0.4rem;">2. Manfaatkan Prompt Caching</h3>
          <p style="font-size: 0.875rem; color: var(--ink-secondary); line-height: 1.6;">
            Anthropic dan OpenAI mendukung fitur <em>Prompt Caching</em>. Jika instruksi sistem atau dokumen referensi Anda berulang (misal dokumen PDF 20 halaman), cache token tersebut untuk memotong biaya input hingga 90% pada panggilan berikutnya.
          </p>
        </div>

        <div style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.25rem; border-radius: var(--radius-sm);">
          <h3 style="font-size: 1rem; color: var(--ink); margin-bottom: 0.4rem;">3. Token Pruning &amp; Semantic Truncation</h3>
          <p style="font-size: 0.875rem; color: var(--ink-secondary); line-height: 1.6;">
            Bersihkan metadata HTML, whitespace berlebih, dan riwayat chat lama sebelum dikirimkan ke model LLM. Mengurangi 1.000 token input per request pada 50.000 request harian menghemat jutaan rupiah per bulan.
          </p>
        </div>
      </div>
    </section>

    <!-- ── FAQ SECTION (MATCHES SCHEMA FAQPAGE) ── -->
    <section id="faq" style="max-width: var(--max-w); margin: 2rem auto; padding: 2rem 1.5rem; border-top: 1px solid var(--border);">
      <div class="section-label">FAQ</div>
      <h2 style="font-family: var(--font-serif); font-size: 1.75rem; color: var(--ink); margin-bottom: 1.5rem;">
        Pertanyaan yang Sering Diajukan (FAQ)
      </h2>

      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <details style="background: var(--bg-card); border: 1px solid var(--border); padding: 1rem 1.25rem; border-radius: var(--radius-sm); cursor: pointer;" open>
          <summary style="font-weight: 600; color: var(--ink); font-size: 1rem; outline: none;">
            Bagaimana cara menghitung estimasi biaya Cloud VPS di Indonesia?
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.925rem; color: var(--ink-secondary); line-height: 1.6;">
            Estimasi biaya Cloud VPS dihitung berdasarkan kombinasi 4 variabel utama: jumlah vCPU, kapasitas RAM, penyimpanan NVMe SSD, dan kuota transfer bandwidth keluar (egress). Kalkulator ini mengalikan spesifikasi yang Anda pilih dengan tarif per jam/bulan masing-masing provider dan mengonversinya ke Rupiah (IDR).
          </p>
        </details>

        <details style="background: var(--bg-card); border: 1px solid var(--border); padding: 1rem 1.25rem; border-radius: var(--radius-sm); cursor: pointer;">
          <summary style="font-weight: 600; color: var(--ink); font-size: 1rem; outline: none;">
            Mengapa provider VPS lokal seperti Biznet Gio dan IDCloudHost seringkali lebih hemat?
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.925rem; color: var(--ink-secondary); line-height: 1.6;">
            Provider lokal memiliki data center fisik di Jakarta dengan koneksi langsung ke Indonesia Internet Exchange (IIX). Mereka memberikan kuota bandwidth lokal gratis yang sangat besar (1-2 TB) dan mematok tarif dalam IDR tetap tanpa risiko fluktuasi kurs mata uang USD atau biaya tersembunyi transfer data antar-region.
          </p>
        </details>

        <details style="background: var(--bg-card); border: 1px solid var(--border); padding: 1rem 1.25rem; border-radius: var(--radius-sm); cursor: pointer;">
          <summary style="font-weight: 600; color: var(--ink); font-size: 1rem; outline: none;">
            Bagaimana cara menghitung kebutuhan token API OpenAI dan Claude?
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.925rem; color: var(--ink-secondary); line-height: 1.6;">
            1 token kira-kira setara dengan 0.75 kata atau 4 karakter dalam bahasa Inggris (dalam bahasa Indonesia sekitar 2-3 karakter per token). Kalikan rata-rata token input dan output per request dengan volume request harian Anda, lalu hitung tarif per 1 juta token sesuai model (misal: GPT-4o, Claude 3.7 Sonnet, atau Gemini 2.5 Flash).
          </p>
        </details>

        <details style="background: var(--bg-card); border: 1px solid var(--border); padding: 1rem 1.25rem; border-radius: var(--radius-sm); cursor: pointer;">
          <summary style="font-weight: 600; color: var(--ink); font-size: 1rem; outline: none;">
            Apa perbedaan antara token input dan token output pada API LLM?
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.925rem; color: var(--ink-secondary); line-height: 1.6;">
            Token input adalah teks prompt, instruksi sistem, dan riwayat percakapan yang Anda kirimkan ke model. Token output adalah teks respons yang dihasilkan oleh model. Token output biasanya dibanderol dengan harga 3 hingga 5 kali lebih mahal daripada token input karena proses komputasi generasi autoregresif yang lebih berat.
          </p>
        </details>
      </div>
    </section>

