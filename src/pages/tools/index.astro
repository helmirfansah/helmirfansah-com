---
// src/pages/tools/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Kalkulator Komisi Affiliate & Engagement Rate Medsos | Helmi Irfansah Tools";
const pageDesc = "Kalkulator interaktif gratis untuk menghitung estimasi komisi affiliate marketing (Shopee, TikTok Shop, SaaS, Web3) dan kalkulator Engagement Rate (ER) serta estimasi rate card endorsement media sosial dalam Rupiah (IDR).";
const pageCanonical = "https://helmirfansah.com/tools";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://helmirfansah.com/tools#app",
      "name": "Kalkulator Komisi Affiliate & Engagement Rate Medsos",
      "url": "https://helmirfansah.com/tools",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "IDR"
      },
      "description": pageDesc,
      "featureList": [
        "Kalkulator Komisi Affiliate Shopee, TikTok Shop, SaaS, dan Web3",
        "Kalkulator Engagement Rate (ER) TikTok, Instagram, YouTube, dan X",
        "Estimasi Nilai Wajar Rate Card Endorsement Influencer",
        "Simulasi Biaya Cloud VPS Server Indonesia vs Global",
        "Estimasi Biaya API Token OpenAI GPT-4o, Claude 3.7, dan Gemini"
      ],
      "author": {
        "@type": "Person",
        "name": "Helmi Irfansah",
        "url": "https://helmirfansah.com"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://helmirfansah.com/tools#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Bagaimana cara menghitung estimasi komisi affiliate marketing di Shopee dan TikTok?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Estimasi komisi dihitung menggunakan rumus: Komisi = Total Views × CTR (Click-Through Rate link) × CVR (Conversion Rate pembelian) × Rata-rata Harga Produk (AOV) × Persentase Komisi Afiliasi. Contohnya, dari 50.000 views dengan CTR 4% didapat 2.000 klik. Dengan CVR 2.5%, terjadi 50 order. Jika harga rata-rata produk Rp 100.000 dan komisi 10%, maka komisi bersih yang didapat adalah Rp 500.000."
          }
        },
        {
          "@type": "Question",
          "name": "Apa itu Conversion Rate (CVR) dan Click-Through Rate (CTR) dalam affiliate marketing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "CTR (Click-Through Rate) adalah persentase audiens yang mengklik link afiliasi Anda dari total penonton konten Anda. Sedangkan CVR (Conversion Rate) adalah persentase orang yang benar-benar menyelesaikan pembelian setelah mengklik link tersebut. Keduanya merupakan metrik kunci untuk melipatgandakan penghasilan afiliasi tanpa harus menambah follower."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana cara menghitung Engagement Rate (ER) Instagram dan TikTok?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rumus standar industri untuk Engagement Rate berbasis followers adalah: ER (%) = ((Total Likes + Komentar + Shares/Saves) ÷ Jumlah Followers) × 100%. Untuk TikTok, shares dan saves diberi bobot lebih tinggi karena algoritma FYP sangat memprioritaskan konten yang dibagikan atau disimpan."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa standar nilai Rate Card endorsement untuk kreator media sosial di Indonesia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standar nilai rate card di Indonesia bervariasi berdasarkan ukuran audiens dan kualitas engagement: Akun Nano (1k-10k followers) berkisar Rp 150.000 - Rp 600.000; Micro (10k-50k followers) berkisar Rp 500.000 - Rp 2.500.000; Mid-tier (50k-200k followers) berkisar Rp 1.500.000 - Rp 6.500.000; dan Macro (200k+ followers) mulai dari Rp 6.500.000 ke atas per video atau post feed."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana cara menghitung estimasi biaya Cloud VPS di Indonesia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Estimasi biaya Cloud VPS dihitung berdasarkan kombinasi 4 variabel utama: jumlah vCPU, kapasitas RAM, penyimpanan NVMe SSD, dan kuota transfer bandwidth keluar (egress). Kalkulator ini mengalikan spesifikasi yang Anda pilih dengan tarif per jam/bulan masing-masing provider dan mengonversinya ke Rupiah (IDR)."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana cara menghitung kebutuhan token API OpenAI dan Claude?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1 token kira-kira setara dengan 0.75 kata atau 4 karakter dalam bahasa Inggris (dalam bahasa Indonesia sekitar 2-3 karakter per token). Kalikan rata-rata token input dan output per request dengan volume request harian Anda, lalu hitung tarif per 1 juta token sesuai model (misal: GPT-4o, Claude 3.7 Sonnet, atau Gemini 2.5 Flash)."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical={pageCanonical}
  schema={schema}
>
  <main id="main-content" style="padding-top: 6.5rem; padding-bottom: 5rem;">
    
    <!-- ── HEADER / HERO ── -->
    <section class="tools-hero" style="max-width: var(--max-w); margin: 0 auto; padding: 0 1.5rem 1.75rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
        <span class="section-label" style="margin-bottom: 0;">KALKULATOR &amp; TOOLS INTERAKTIF</span>
        <span style="font-size: 11px; padding: 0.2rem 0.5rem; background: var(--bg-alt); border: 1px solid var(--border-strong); border-radius: 999px; color: var(--accent-clay); font-weight: 600;">Update September 2026</span>
      </div>
      
      <h1 style="font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.15; color: var(--ink); margin-bottom: 1rem;">
        Kalkulator Komisi Affiliate &amp; <em style="font-style: italic; color: var(--accent-clay);">Engagement Rate</em> Medsos
      </h1>
      
      <p style="font-size: 1.05rem; color: var(--ink-secondary); max-width: 760px; line-height: 1.6; margin-bottom: 1.75rem;">
        Kumpulan kalkulator interaktif gratis untuk mengukur potensi komisi <strong>affiliate marketing</strong> (Shopee, TikTok, SaaS, Web3), tolak ukur <strong>engagement rate (ER)</strong> &amp; estimasi <strong>rate card endorsement</strong>, serta simulator biaya cloud VPS dan token API AI dalam Rupiah (IDR).
      </p>

      <!-- Quick Nav Buttons -->
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href="#kalkulator" class="btn-primary" style="padding: 0.6rem 1.25rem; font-size: 0.85rem;">
          ⚙️ Buka Kalkulator Interaktif
        </a>
        <a href="#panduan-affiliate" class="btn-ghost" style="padding: 0.6rem 1.25rem; font-size: 0.85rem;">
          💰 Panduan Rumus Afiliasi
        </a>
        <a href="#panduan-er" class="btn-ghost" style="padding: 0.6rem 1.25rem; font-size: 0.85rem;">
          📊 Standar ER Medsos
        </a>
        <a href="#faq" class="btn-ghost" style="padding: 0.6rem 1.25rem; font-size: 0.85rem;">
          ❓ Tanya Jawab (FAQ)
        </a>
      </div>
    </section>

    <!-- ── CALCULATOR CONTAINER ── -->
    <section id="kalkulator" style="max-width: var(--max-w); margin: 0 auto; padding: 1rem 1.5rem 3rem;">
      <div class="calc-container" id="tools-calc" style="box-shadow: var(--shadow-sm); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; background: var(--bg-card);">
        
        <div class="calc-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; border-bottom: 1px solid var(--border); padding: 1.25rem 1.5rem; background: var(--bg-alt);">
          <div>
            <h2 style="font-family: var(--font-serif); font-size: 1.35rem; font-weight: 500; color: var(--ink); margin-bottom: 0.25rem;">
              Simulasi Data &amp; Kalkulasi Instan
            </h2>
            <p style="font-size: 0.875rem; color: var(--ink-muted); margin: 0;">
              Pilih jenis kalkulator di bawah, lalu sesuaikan tuas parameter untuk melihat proyeksi angka seketika.
            </p>
          </div>
          <div class="calc-tabs" role="tablist" aria-label="Pilih Jenis Kalkulator" style="border: none; padding: 0; background: transparent; display: flex; flex-wrap: wrap; gap: 0.4rem;">
            <button class="calc-tab active" role="tab" aria-selected="true" data-tab="affiliate" style="font-weight: 600; font-size: 0.85rem;">
              💰 Komisi Afiliasi (Cuan &amp; ROI)
            </button>
            <button class="calc-tab" role="tab" aria-selected="false" data-tab="social" style="font-weight: 600; font-size: 0.85rem;">
              📊 ER &amp; Rate Card Medsos
            </button>
            <button class="calc-tab" role="tab" aria-selected="false" data-tab="cloud" style="font-weight: 600; font-size: 0.85rem;">
              ☁️ Cloud VPS (IDR)
            </button>
            <button class="calc-tab" role="tab" aria-selected="false" data-tab="ai" style="font-weight: 600; font-size: 0.85rem;">
              🤖 Token API AI
            </button>
          </div>
        </div>

        <!-- ── TAB 1: AFFILIATE COMMISSION CALCULATOR ── -->
        <div class="calc-body" id="tab-affiliate" role="tabpanel" style="padding: 1.5rem;">
          
          <!-- Dedicated URL Banner -->
          <div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.6rem 1rem; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
            <span style="font-size: 0.8rem; color: var(--ink-secondary);">
              📍 URL Halaman Khusus: <a href="/tools/kalkulator-affiliate" style="font-family: var(--font-mono); color: var(--accent-clay); font-weight: 600;">/tools/kalkulator-affiliate</a>
            </span>
            <a href="/tools/kalkulator-affiliate" class="btn-ghost" style="font-size: 0.75rem; padding: 0.25rem 0.65rem;">
              Buka Halaman Penuh &rarr;
            </a>
          </div>

          <!-- Preset Buttons -->
          <div style="margin-bottom: 1.25rem; display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
            <span style="font-size: 0.8rem; font-weight: 600; color: var(--ink-muted); margin-right: 0.25rem;">Preset Cepat:</span>
            <button type="button" class="aff-preset-btn active" data-preset="shopee" style="font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid var(--border-strong); background: var(--bg); color: var(--ink); cursor: pointer;">
              🛍️ Shopee (7%)
            </button>
            <button type="button" class="aff-preset-btn" data-preset="tiktok" style="font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid var(--border-strong); background: var(--bg); color: var(--ink); cursor: pointer;">
              🎵 TikTok Shop (12%)
            </button>
            <button type="button" class="aff-preset-btn" data-preset="saas" style="font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid var(--border-strong); background: var(--bg); color: var(--ink); cursor: pointer;">
              💻 SaaS / Digital (35%)
            </button>
            <button type="button" class="aff-preset-btn" data-preset="web3" style="font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid var(--border-strong); background: var(--bg); color: var(--ink); cursor: pointer;">
              ⚡ Web3 Referral (25%)
            </button>
          </div>

          <div class="calc-inputs" style="background: var(--bg-alt); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border); display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
            
            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="aff-views" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Estimasi Views / Traffic:</label>
                <strong id="aff-views-val" style="font-family: var(--font-mono); color: var(--accent-clay);">60.000 Views</strong>
              </div>
              <input type="range" id="aff-views" min="1000" max="1000000" value="60000" step="1000" aria-label="Views Bulanan">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Total penonton video / pembaca blog per bulan.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="aff-ctr" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Click-Through Rate (CTR):</label>
                <strong id="aff-ctr-val" style="font-family: var(--font-mono); color: var(--accent-clay);">4.0%</strong>
              </div>
              <input type="range" id="aff-ctr" min="0.5" max="20" value="4.0" step="0.1" aria-label="CTR Klik Link">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Rata-rata link bio/deskripsi: 2% - 6%.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="aff-cvr" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Conversion Rate (CVR):</label>
                <strong id="aff-cvr-val" style="font-family: var(--font-mono); color: var(--accent-clay);">2.5%</strong>
              </div>
              <input type="range" id="aff-cvr" min="0.5" max="15" value="2.5" step="0.1" aria-label="Tingkat Konversi Pembelian">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Persentase klik yang menjadi pembeli (1.5% - 4%).</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="aff-price" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Rata-rata Harga Produk (AOV):</label>
                <strong id="aff-price-val" style="font-family: var(--font-mono); color: var(--accent-clay);">Rp 125.000</strong>
              </div>
              <input type="range" id="aff-price" min="10000" max="2000000" value="125000" step="5000" aria-label="Harga Rata-rata Produk">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Nilai keranjang belanja rata-rata per transaksi.</span>
            </div>

            <div class="input-group" style="grid-column: 1 / -1;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="aff-comm" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Persentase Komisi Afiliasi:</label>
                <strong id="aff-comm-val" style="font-family: var(--font-mono); color: var(--accent-clay);">7.0%</strong>
              </div>
              <input type="range" id="aff-comm" min="1" max="50" value="7.0" step="0.5" aria-label="Persentase Komisi">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Fisik/E-commerce: 5%-15% | Digital/Web3: 20%-50%.</span>
            </div>

          </div>

          <div style="margin-top: 1.5rem;">
            <div class="calc-results" id="affiliate-results">
              <!-- Rendered via JS -->
            </div>
          </div>
        </div>

        <!-- ── TAB 2: SOCIAL MEDIA ER & RATE CARD CALCULATOR ── -->
        <div class="calc-body hidden" id="tab-social" role="tabpanel" style="padding: 1.5rem;">
          
          <!-- Dedicated URL Banner -->
          <div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.6rem 1rem; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
            <span style="font-size: 0.8rem; color: var(--ink-secondary);">
              📍 URL Halaman Khusus: <a href="/tools/kalkulator-engagement-rate" style="font-family: var(--font-mono); color: var(--accent-clay); font-weight: 600;">/tools/kalkulator-engagement-rate</a>
            </span>
            <a href="/tools/kalkulator-engagement-rate" class="btn-ghost" style="font-size: 0.75rem; padding: 0.25rem 0.65rem;">
              Buka Halaman Penuh &rarr;
            </a>
          </div>

          <!-- Platform Selection -->
          <div style="margin-bottom: 1.25rem;">
            <label style="font-size: 0.85rem; font-weight: 600; color: var(--ink); display: block; margin-bottom: 0.5rem;">
              Pilih Platform Media Sosial:
            </label>
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
              <label style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.85rem; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 4px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
                <input type="radio" name="soc-platform" value="tiktok" checked style="accent-color: var(--accent-clay);">
                🎵 TikTok
              </label>
              <label style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.85rem; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 4px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
                <input type="radio" name="soc-platform" value="instagram" style="accent-color: var(--accent-clay);">
                📸 Instagram
              </label>
              <label style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.85rem; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 4px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
                <input type="radio" name="soc-platform" value="youtube" style="accent-color: var(--accent-clay);">
                ▶️ YouTube
              </label>
              <label style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.85rem; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 4px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
                <input type="radio" name="soc-platform" value="twitter" style="accent-color: var(--accent-clay);">
                𝕏 / Twitter
              </label>
            </div>
          </div>

          <div class="calc-inputs" style="background: var(--bg-alt); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border); display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
            
            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="soc-followers" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Jumlah Followers / Subs:</label>
                <strong id="soc-followers-val" style="font-family: var(--font-mono); color: var(--accent-clay);">25.000 Followers</strong>
              </div>
              <input type="range" id="soc-followers" min="1000" max="1000000" value="25000" step="1000" aria-label="Jumlah Followers">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Total pengikut aktif akun Anda saat ini.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="soc-likes" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Rata-rata Likes / Konten:</label>
                <strong id="soc-likes-val" style="font-family: var(--font-mono); color: var(--accent-clay);">1.200 Likes</strong>
              </div>
              <input type="range" id="soc-likes" min="10" max="100000" value="1200" step="50" aria-label="Rata-rata Likes">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Ambil sampel dari 10 postingan organik terakhir.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="soc-comments" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Rata-rata Komentar / Konten:</label>
                <strong id="soc-comments-val" style="font-family: var(--font-mono); color: var(--accent-clay);">85 Komentar</strong>
              </div>
              <input type="range" id="soc-comments" min="0" max="10000" value="85" step="5" aria-label="Rata-rata Komentar">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Komentar publik dari audiens riil.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="soc-shares" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Rata-rata Shares / Saves:</label>
                <strong id="soc-shares-val" style="font-family: var(--font-mono); color: var(--accent-clay);">45 Shares</strong>
              </div>
              <input type="range" id="soc-shares" min="0" max="10000" value="45" step="5" aria-label="Rata-rata Shares atau Simpan">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Metrik bernilai tinggi pendorong algoritma rekomendasi.</span>
            </div>

          </div>

          <div style="margin-top: 1.5rem;">
            <div class="calc-results" id="social-results">
              <!-- Rendered via JS -->
            </div>
          </div>
        </div>

        <!-- ── TAB 3: CLOUD VPS CALCULATOR ── -->
        <div class="calc-body hidden" id="tab-cloud" role="tabpanel" style="padding: 1.5rem;">

          <!-- Dedicated URL Banner -->
          <div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.6rem 1rem; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
            <span style="font-size: 0.8rem; color: var(--ink-secondary);">
              📍 URL Halaman Khusus: <a href="/tools/kalkulator-cloud-vps" style="font-family: var(--font-mono); color: var(--accent-clay); font-weight: 600;">/tools/kalkulator-cloud-vps</a>
            </span>
            <a href="/tools/kalkulator-cloud-vps" class="btn-ghost" style="font-size: 0.75rem; padding: 0.25rem 0.65rem;">
              Buka Halaman Penuh &rarr;
            </a>
          </div>

