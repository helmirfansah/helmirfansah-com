---
// src/pages/tools/kalkulator-engagement-rate.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Kalkulator Engagement Rate (ER) & Rate Card Endorsement Medsos | Helmi Irfansah Tools";
const pageDesc = "Kalkulator Engagement Rate (ER) gratis untuk TikTok, Instagram, YouTube, dan Twitter (𝕏). Dapatkan evaluasi kualitas interaksi akun dan estimasi wajar rate card endorsement influencer di Indonesia.";
const pageCanonical = "https://helmirfansah.com/tools/kalkulator-engagement-rate";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://helmirfansah.com/tools/kalkulator-engagement-rate#app",
      "name": "Kalkulator Engagement Rate & Rate Card Medsos",
      "url": pageCanonical,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "IDR"
      },
      "description": pageDesc,
      "author": {
        "@type": "Person",
        "name": "Helmi Irfansah",
        "url": "https://helmirfansah.com"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://helmirfansah.com/tools/kalkulator-engagement-rate#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Bagaimana rumus menghitung Engagement Rate (ER) di media sosial?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rumus standar ER berbasis followers: ER (%) = ((Total Likes + Komentar + Shares/Saves) ÷ Total Followers) × 100%. Untuk TikTok dan Instagram, interaksi shares dan saves memiliki bobot lebih tinggi dalam algoritma rekomendasi."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa tolak ukur Engagement Rate yang dianggap bagus untuk TikTok dan Instagram?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Untuk akun nano-micro (1k-50k followers), ER 3% - 6% tergolong sangat sehat dan bagus. Untuk akun besar (di atas 100k followers), ER 1.5% - 3% sudah tergolong rata-rata standar industri."
          }
        },
        {
          "@type": "Question",
          "name": "Mengapa Engagement Rate mempengaruhi nilai rate card endorsement?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Brand lebih memilih kreator dengan audiens yang responsif dan aktif membeli daripada akun besar dengan jutaan followers palsu atau pasif. Akun dengan ER tinggi terbukti menghasilkan CTR dan ROI penjualan yang lebih memuaskan bagi sponsor."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical={pageCanonical}
  schema={schema}
>
  <main id="main-content" style="padding-top: 6.5rem; padding-bottom: 5rem;">
    
    <!-- ── BREADCRUMB & HERO ── -->
    <section style="max-width: var(--max-w); margin: 0 auto; padding: 0 1.5rem 1.75rem;">
      <nav aria-label="Breadcrumb" style="font-size: 0.825rem; color: var(--ink-muted); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <a href="/" style="color: var(--ink-muted); text-decoration: none;">Beranda</a>
        <span style="opacity: 0.4;">/</span>
        <a href="/tools" style="color: var(--ink-muted); text-decoration: none;">Kalkulator &amp; Tools</a>
        <span style="opacity: 0.4;">/</span>
        <span style="color: var(--accent-clay); font-weight: 600;">Kalkulator Engagement Rate</span>
      </nav>

      <!-- Sleek Segmented Switcher -->
      <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1.75rem; background: var(--bg-alt); border: 1px solid var(--border); padding: 0.35rem; border-radius: 8px; width: fit-content; max-width: 100%;">
        <a href="/tools/kalkulator-affiliate" style="font-size: 0.8rem; font-weight: 500; padding: 0.4rem 0.85rem; border-radius: 6px; color: var(--ink-secondary); text-decoration: none;">
          💰 Komisi Afiliasi
        </a>
        <span style="font-size: 0.8rem; font-weight: 600; padding: 0.4rem 0.85rem; border-radius: 6px; background: var(--accent-clay); color: #fff;">
          📊 ER &amp; Rate Card
        </span>
        <a href="/tools/kalkulator-cloud-vps" style="font-size: 0.8rem; font-weight: 500; padding: 0.4rem 0.85rem; border-radius: 6px; color: var(--ink-secondary); text-decoration: none;">
          ☁️ Cloud VPS
        </a>
        <a href="/tools/kalkulator-token-ai" style="font-size: 0.8rem; font-weight: 500; padding: 0.4rem 0.85rem; border-radius: 6px; color: var(--ink-secondary); text-decoration: none;">
          🤖 Token AI
        </a>
      </div>

      <h1 style="font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.15; color: var(--ink); margin-bottom: 0.75rem;">
        Kalkulator <em style="font-style: italic; color: var(--accent-clay);">Engagement Rate</em> &amp; Rate Card Medsos
      </h1>
      <p style="font-size: 1.05rem; color: var(--ink-secondary); max-width: 760px; line-height: 1.6; margin-bottom: 1.5rem;">
        Ukur tingkat interaksi akun TikTok, Instagram, YouTube, dan 𝕏 Anda. Ketahui apakah performa akun Anda masuk kategori sehat, viral, atau butuh optimasi, serta dapatkan rekomendasi tarif endorse wajar di pasar Indonesia.
      </p>
    </section>

    <!-- ── CALCULATOR CONTAINER ── -->
    <section style="max-width: var(--max-w); margin: 0 auto; padding: 0 1.5rem 3rem;">
      <div class="calc-container" style="box-shadow: var(--shadow-sm); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; background: var(--bg-card);">
        
        <div class="calc-header" style="border-bottom: 1px solid var(--border); padding: 1.25rem 1.5rem; background: var(--bg-alt); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
          <div>
            <h2 style="font-family: var(--font-serif); font-size: 1.3rem; font-weight: 500; color: var(--ink); margin: 0 0 0.25rem;">
              Analisis Interaksi &amp; Valuasi Endorse
            </h2>
            <p style="font-size: 0.85rem; color: var(--ink-muted); margin: 0;">
              Masukkan rata-rata metrik dari 5–10 postingan organik terakhir Anda.
            </p>
          </div>
          <a href="/tools" class="btn-ghost" style="font-size: 0.8rem; padding: 0.4rem 0.85rem;">
            ← Semua Tools &amp; Hub
          </a>
        </div>

        <div class="calc-body" style="padding: 1.5rem;">
          <!-- Platform Selection -->
          <div style="margin-bottom: 1.25rem;">
            <label style="font-size: 0.85rem; font-weight: 600; color: var(--ink); display: block; margin-bottom: 0.5rem;">
              Pilih Platform Media Sosial:
            </label>
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
              <label style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.85rem; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 4px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
                <input type="radio" name="soc-platform" value="tiktok" checked style="accent-color: var(--accent-clay);">
                🎵 TikTok
              </label>
              <label style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.85rem; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 4px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
                <input type="radio" name="soc-platform" value="instagram" style="accent-color: var(--accent-clay);">
                📸 Instagram
              </label>
              <label style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.85rem; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 4px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
                <input type="radio" name="soc-platform" value="youtube" style="accent-color: var(--accent-clay);">
                ▶️ YouTube
              </label>
              <label style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.85rem; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 4px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
                <input type="radio" name="soc-platform" value="twitter" style="accent-color: var(--accent-clay);">
                𝕏 / Twitter
              </label>
            </div>
          </div>

          <div class="calc-inputs" style="background: var(--bg-alt); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border); display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
            
            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="soc-followers" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Jumlah Followers / Subs:</label>
                <strong id="soc-followers-val" style="font-family: var(--font-mono); color: var(--accent-clay);">25.000 Followers</strong>
              </div>
              <input type="range" id="soc-followers" min="1000" max="1000000" value="25000" step="1000" aria-label="Jumlah Followers">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Total pengikut aktif akun Anda saat ini.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="soc-likes" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Rata-rata Likes / Konten:</label>
                <strong id="soc-likes-val" style="font-family: var(--font-mono); color: var(--accent-clay);">1.200 Likes</strong>
              </div>
              <input type="range" id="soc-likes" min="10" max="100000" value="1200" step="50" aria-label="Rata-rata Likes">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Rata-rata likes per postingan organik.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="soc-comments" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Rata-rata Komentar / Konten:</label>
                <strong id="soc-comments-val" style="font-family: var(--font-mono); color: var(--accent-clay);">85 Komentar</strong>
              </div>
              <input type="range" id="soc-comments" min="0" max="10000" value="85" step="5" aria-label="Rata-rata Komentar">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Komentar publik dari audiens riil.</span>
            </div>

            <div class="input-group">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.4rem;">
                <label for="soc-shares" style="font-size: 0.85rem; font-weight: 600; color: var(--ink);">Rata-rata Shares / Saves:</label>
                <strong id="soc-shares-val" style="font-family: var(--font-mono); color: var(--accent-clay);">45 Shares</strong>
              </div>
              <input type="range" id="soc-shares" min="0" max="10000" value="45" step="5" aria-label="Rata-rata Shares atau Simpan">
              <span style="font-size: 11px; color: var(--ink-muted); display: block; margin-top: 0.25rem;">Metrik bernilai tinggi pendorong algoritma rekomendasi.</span>
            </div>

          </div>

          <div style="margin-top: 1.5rem;">
            <div class="calc-results" id="social-results">
              <!-- Rendered via JS -->
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── SEO ARTICLE & BENCHMARK TABLE ── -->
    <section style="max-width: var(--max-w); margin: 0 auto; padding: 2rem 1.5rem; border-top: 1px solid var(--border);">
      <div class="section-label">ANALISIS PASAR INDONESIA</div>
      <h2 style="font-family: var(--font-serif); font-size: 1.75rem; color: var(--ink); margin-bottom: 1rem;">
        Bagaimana Cara Kreator Memasang Rate Card yang Menguntungkan?
      </h2>
      <p style="color: var(--ink-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
        Menentukan tarif endorsement seringkali membingungkan: jika terlalu mahal, brand akan mundur; jika terlalu murah, Anda akan lelah memproduksi video dengan margin tipis. Tiga strategi penetapan harga:
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 1.5rem;">
        <div style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.25rem; border-radius: var(--radius-sm);">
          <h3 style="font-size: 1.05rem; color: var(--ink); margin-bottom: 0.5rem;">1. Bundle Package</h3>
          <p style="font-size: 0.875rem; color: var(--ink-secondary); line-height: 1.6;">
            Jangan jual 1 video lepas. Tawarkan paket: 1 Video Utama + 2 Story pengingat + 1 Link bio selama 14 hari dengan potongan diskon 15%. Ini meningkatkan total nilai deal Anda.
          </p>
        </div>
        <div style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.25rem; border-radius: var(--radius-sm);">
          <h3 style="font-size: 1.05rem; color: var(--ink); margin-bottom: 0.5rem;">2. Biaya Hak Iklan (Usage Rights)</h3>
          <p style="font-size: 0.875rem; color: var(--ink-secondary); line-height: 1.6;">
            Jika brand ingin mengiklankan video Anda via TikTok Spark Ads atau Meta Ads, kenakan biaya tambahan 30% - 50% dari harga dasar sebagai lisensi pemakaian konten komersial.
          </p>
        </div>
        <div style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.25rem; border-radius: var(--radius-sm);">
          <h3 style="font-size: 1.05rem; color: var(--ink); margin-bottom: 0.5rem;">3. Model Hybrid (Base + Komisi)</h3>
          <p style="font-size: 0.875rem; color: var(--ink-secondary); line-height: 1.6;">
            Kombinasikan rate card endorsement tetap (misal Rp 1.500.000) ditambah komisi afiliasi 10% dari setiap penjualan yang dihasilkan melalui link atau kode voucher khusus Anda.
          </p>
        </div>
      </div>
    </section>

    <!-- ── FAQ SECTION ── -->
    <section style="max-width: var(--max-w); margin: 0 auto; padding: 2rem 1.5rem; border-top: 1px solid var(--border);">
      <div class="section-label">FAQ ENGAGEMENT RATE</div>
      <h2 style="font-family: var(--font-serif); font-size: 1.75rem; color: var(--ink); margin-bottom: 1.5rem;">
        Pertanyaan Umum Seputar ER &amp; Rate Card
      </h2>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <details style="background: var(--bg-card); border: 1px solid var(--border); padding: 1rem 1.25rem; border-radius: var(--radius-sm); cursor: pointer;" open>
          <summary style="font-weight: 600; color: var(--ink); font-size: 1rem; outline: none;">
            Bagaimana rumus menghitung Engagement Rate (ER) di media sosial?
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.925rem; color: var(--ink-secondary); line-height: 1.6;">
            Rumus standar ER berbasis followers: ER (%) = ((Total Likes + Komentar + Shares/Saves) ÷ Total Followers) × 100%. Untuk TikTok dan Instagram, interaksi shares dan saves memiliki bobot lebih tinggi dalam algoritma rekomendasi.
          </p>
        </details>
        <details style="background: var(--bg-card); border: 1px solid var(--border); padding: 1rem 1.25rem; border-radius: var(--radius-sm); cursor: pointer;">
          <summary style="font-weight: 600; color: var(--ink); font-size: 1rem; outline: none;">
            Berapa tolak ukur Engagement Rate yang dianggap bagus untuk TikTok dan Instagram?
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.925rem; color: var(--ink-secondary); line-height: 1.6;">
            Untuk akun nano-micro (1k-50k followers), ER 3% - 6% tergolong sangat sehat dan bagus. Untuk akun besar (di atas 100k followers), ER 1.5% - 3% sudah tergolong rata-rata standar industri.
          </p>
        </details>
        <details style="background: var(--bg-card); border: 1px solid var(--border); padding: 1rem 1.25rem; border-radius: var(--radius-sm); cursor: pointer;">
          <summary style="font-weight: 600; color: var(--ink); font-size: 1rem; outline: none;">
            Mengapa Engagement Rate mempengaruhi nilai rate card endorsement?
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.925rem; color: var(--ink-secondary); line-height: 1.6;">
            Brand lebih memilih kreator dengan audiens yang responsif dan aktif membeli daripada akun besar dengan jutaan followers palsu atau pasif. Akun dengan ER tinggi terbukti menghasilkan CTR dan ROI penjualan yang lebih memuaskan bagi sponsor.
          </p>
        </details>
      </div>
    </section>

  </main>
</BaseLayout>
