    async function testSupabasePing() {
      const url = document.getElementById('sb-cfg-url').value.trim();
      const key = document.getElementById('sb-cfg-key').value.trim();
      if (!url || !key) {
        showToast('Isi URL dan API Key terlebih dahulu!');
        updateSbModalBanner(false, 'Harap isi kolom Project URL dan Anon API Key sebelum menguji koneksi.');
        return;
      }
      showToast('Menguji koneksi ke Supabase...');
      const res = await window.BlogService.testConnection(url, key);
      if (res.success) {
        updateSbModalBanner(true, res.message);
        showToast(res.message);
      } else {
        updateSbModalBanner(false, res.message);
        showToast(res.message);
      }
    }

    async function copySchemaSql() {
      try {
        const res = await fetch('/schema.sql');
        if (!res.ok) throw new Error('File schema.sql tidak dapat diakses');
        const text = await res.text();
        await navigator.clipboard.writeText(text);
        showToast('✅ Berhasil menyalin schema.sql ke clipboard!');
