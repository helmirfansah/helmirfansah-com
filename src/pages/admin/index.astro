      const cfg = window.BlogService.getConfig();
      document.getElementById('sb-cfg-url').value = cfg.url || '';
      document.getElementById('sb-cfg-key').value = cfg.anonKey || '';
      updateSbModalBanner(window.BlogService.isLive);
      document.getElementById('modal-supabase').style.display = 'flex';
