    function setToolsFilter(filter) {
      currentToolsFilter = filter;
      const btns = {
        all: document.getElementById('btn-filter-tool-all'),
        active: document.getElementById('btn-filter-tool-active'),
        inactive: document.getElementById('btn-filter-tool-inactive')
      };
      Object.keys(btns).forEach(key => {
        if (btns[key]) {
          btns[key].classList.toggle('active', key === filter);
          if (key === filter) {
            btns[key].style.background = 'var(--wp-brand)';
            btns[key].style.color = '#FFF';
          } else {
            btns[key].style.background = '';
            btns[key].style.color = '';
          }
        }
      });
      renderToolsAdmin();
    }

    function onToolsSearch(val) {
      currentToolsSearch = (val || '').toLowerCase().trim();
      renderToolsAdmin();
    }

    function renderToolsAdmin() {
      if (!window.BlogService || !window.BlogService.getTools) return;
      const allTools = window.BlogService.getTools() || [];

      // Update Metric KPI
      const total = allTools.length;
      const active = allTools.filter(t => t.is_active !== false).length;
      const inactive = total - active;
      const kwCount = allTools.filter(t => t.target_keyword && t.target_keyword.trim().length > 0).length;

      const elTotal = document.getElementById('stat-tools-total');
      const elActive = document.getElementById('stat-tools-active');
      const elInactive = document.getElementById('stat-tools-inactive');
      const elKw = document.getElementById('stat-tools-keywords');
      const elBadge = document.getElementById('tools-kpi-badge');

      if (elTotal) elTotal.textContent = `${total} Unit`;
      if (elActive) elActive.textContent = `${active} Unit`;
      if (elInactive) elInactive.textContent = `${inactive} Unit`;
