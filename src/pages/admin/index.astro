    function openEditToolModal(id) {
      if (!window.BlogService) return;
      const tools = window.BlogService.getTools() || [];
      const tool = tools.find(t => t.id === id);
      if (!tool) {
        showToast('Tool tidak ditemukan!');
        return;
      }

      document.getElementById('tool-form-id').value = tool.id || '';
      document.getElementById('tool-form-name').value = tool.name || '';
      document.getElementById('tool-form-icon').value = tool.icon || '⚙️';
      document.getElementById('tool-form-category').value = tool.category || 'Affiliate Marketing';
      document.getElementById('tool-form-badge').value = tool.badge || '';
      document.getElementById('tool-form-slug').value = tool.slug || '/tools/';
      document.getElementById('tool-form-keyword').value = tool.target_keyword || '';
      document.getElementById('tool-form-meta-desc').value = tool.meta_description || '';
      document.getElementById('tool-form-desc').value = tool.description || '';
      const isActive = tool.is_active !== false;
      document.getElementById('tool-form-active').checked = isActive;
      updateToolFormActiveLabel(isActive);

      document.getElementById('tool-modal-title').textContent = `Edit Tool: ${tool.name}`;
      document.getElementById('tool-modal-icon-badge').textContent = tool.icon || '✏️';
      document.getElementById('modal-tool-editor').style.display = 'flex';
