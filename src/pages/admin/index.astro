    async function handleImportBackup() {
      const fileInput = document.getElementById('import-file');
      if (!fileInput.files || !fileInput.files[0]) {
        alert('Pilih file JSON cadangan.');
        return;
      }
      const reader = new FileReader();
      reader.onload = async (e) => {
        try {
          const { count } = await window.BlogService.importData(e.target.result);
          showToast(`Berhasil mengimpor ${count} artikel cadangan!`);
          refreshPosts();
          populateCategorySelects();
        } catch (err) {
          alert('Gagal impor: ' + err.message);
        }
      };
      reader.readAsText(fileInput.files[0]);
    }

    // --- 9. SUPABASE CONFIG MODAL & LAB SIMULATOR ---
    function updateSbModalBanner(isLive, message) {
      const banner = document.getElementById('sb-diag-banner');
      const icon = document.getElementById('sb-diag-icon');
      const title = document.getElementById('sb-diag-title');
      const text = document.getElementById('sb-diag-text');
      if (!banner) return;

      if (isLive) {
        banner.style.background = 'rgba(16, 185, 129, 0.12)';
        banner.style.border = '1px solid rgba(16, 185, 129, 0.3)';
        banner.style.color = '#34D399';
        icon.textContent = '🟢';
        title.textContent = 'Status: Terhubung ke Supabase Cloud (Live)';
        text.textContent = message || 'Database PostgreSQL Supabase aktif dan tersinkronisasi. Semua postingan tersimpan secara permanen di cloud.';
      } else if (message && message.includes('TETAPI tabel')) {
        banner.style.background = 'rgba(239, 68, 68, 0.12)';
        banner.style.border = '1px solid rgba(239, 68, 68, 0.3)';
        banner.style.color = '#F87171';
        icon.textContent = '⚠️';
        title.textContent = 'Terkoneksi, tapi Tabel Belum Dibuat!';
        text.textContent = message;
      } else {
        const cfg = window.BlogService.getConfig();
        const hasUrl = !!cfg.url;
        banner.style.background = hasUrl ? 'rgba(245, 158, 11, 0.12)' : 'rgba(107, 114, 128, 0.12)';
        banner.style.border = hasUrl ? '1px solid rgba(245, 158, 11, 0.3)' : '1px solid rgba(107, 114, 128, 0.3)';
        banner.style.color = hasUrl ? '#FBBF24' : '#D1D5DB';
        icon.textContent = hasUrl ? '⚠️' : 'ℹ️';
        title.textContent = hasUrl ? 'Status: Kunci Terisi, tapi Belum Tersambung' : 'Status: Belum Terhubung (Mode Lokal Offline)';
        text.textContent = message || (hasUrl ? 'Periksa kembali Project URL dan Anon Key Anda, atau klik "Uji & Tes Koneksi" di bawah.' : 'Website saat ini menyimpan data di local storage browser. Masukkan Project URL dan Anon Key Supabase untuk sinkronisasi cloud.');
      }
    }

