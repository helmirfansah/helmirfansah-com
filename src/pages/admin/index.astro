  <script is:inline define:vars={{ supabaseUrl, supabaseAnonKey }}>
    if (supabaseUrl) window.__PUBLIC_SUPABASE_URL__ = supabaseUrl;
    if (supabaseAnonKey) window.__PUBLIC_SUPABASE_ANON_KEY__ = supabaseAnonKey;
  </script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script is:inline src="/supabase-client.js"></script>
  <script is:inline>
    // State
    let currentPosts = [];
    let currentStatusFilter = 'all';
    let currentCategoryFilter = 'Semua';
    let searchQuery = '';
    let selectedPostIds = new Set();
    let selectedMediaUrl = '';
    let mediaTargetMode = '';
    let autoSaveTimer = null;

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3000);
    }

    // --- 1. BOOT & AUTO-LOGIN (PERSISTENT SESSION) ---
    async function bootAdmin() {
      const loader = document.getElementById('auth-loader');
      try {
        const session = await window.BlogService.getSession();
        if (session && session.user) {
          launchDashboard(session.user);
        } else {
          document.getElementById('view-login').style.display = 'flex';
          document.getElementById('view-dashboard').style.display = 'none';
        }
      } catch (e) {
        console.warn('Boot auth error:', e);
        document.getElementById('view-login').style.display = 'flex';
      } finally {
        loader.style.opacity = '0';
        setTimeout(() => loader.style.display = 'none', 250);
      }
    }

    async function handleAuthLogin(e) {
      e.preventDefault();
      const email = document.getElementById('login-email').value.trim();
      const password = document.getElementById('login-password').value.trim();
      const btn = document.getElementById('btn-login');

      btn.textContent = 'Memverifikasi...';
      btn.disabled = true;

      const { data, error } = await window.BlogService.login(email, password);
      btn.disabled = false;
      btn.textContent = 'Masuk Dashboard Studio →';

      if (error) {
        alert('Gagal login: ' + error.message);
        return;
      }

      showToast('Login berhasil! Memuat sesi...');
      launchDashboard(data.user);
    }

    function launchDashboard(user) {
      document.getElementById('view-login').style.display = 'none';
      document.getElementById('view-dashboard').style.display = 'flex';

      const email = user.email || 'admin@helmirfansah.com';
      document.getElementById('sidebar-email').textContent = email;
      document.getElementById('sidebar-avatar').textContent = email.substring(0, 2).toUpperCase();

      initDashboardData();
    }

    async function handleLogout() {
      if (confirm('Apakah Anda yakin ingin keluar dari sesi admin?')) {
        await window.BlogService.logout();
        showToast('Sesi ditutup.');
        document.getElementById('view-dashboard').style.display = 'none';
        document.getElementById('view-login').style.display = 'flex';
      }
    }

    // --- 2. NAVIGATION DISPATCHER ---
    function toggleNavSubmenu(forceOpen) {
      const sublist = document.getElementById('sublist-navigation');
      const arrow = document.getElementById('nav-arrow-navigation');
      if (!sublist) return;
      const isOpen = sublist.style.display !== 'none';
      const nextOpen = forceOpen !== undefined ? forceOpen : !isOpen;
      sublist.style.display = nextOpen ? 'flex' : 'none';
      if (arrow) arrow.classList.toggle('open', nextOpen);
    }

    function switchNav(section) {
      const isNavSection = (section === 'navigation' || section === 'nav-main' || section === 'nav-footer');
      const activeSecKey = isNavSection ? 'navigation' : section;

      const allSections = ['posts', 'editor', 'categories', 'lab-tools', 'media', 'backup', 'settings', 'branding', 'navigation'];
      allSections.forEach(sec => {
        const el = document.getElementById(`section-${sec}`);
        if (el) el.style.display = (sec === activeSecKey) ? 'block' : 'none';

        const btn = document.getElementById(`nav-${sec}`);
        if (btn) btn.classList.toggle('active', sec === activeSecKey);
      });

      // Handle submenu active states for Navigasi
      if (isNavSection) {
        toggleNavSubmenu(true);
        const subMain = document.getElementById('nav-sub-main');
        const subFooter = document.getElementById('nav-sub-footer');
        if (section === 'nav-footer') {
          if (subMain) subMain.classList.remove('active');
          if (subFooter) subFooter.classList.add('active');
          switchNavTab('footer');
        } else {
          if (subMain) subMain.classList.add('active');
          if (subFooter) subFooter.classList.remove('active');
          switchNavTab('main');
        }
      } else {
        const subMain = document.getElementById('nav-sub-main');
        const subFooter = document.getElementById('nav-sub-footer');
        if (subMain) subMain.classList.remove('active');
        if (subFooter) subFooter.classList.remove('active');
      }

      const titles = {
        posts: 'Semua Artikel',
        editor: 'Editor Artikel',
        categories: 'Kategori & Topik',
        'lab-tools': 'Lab & Tools Interaktif',
        media: 'Pustaka Media & Aset',
        branding: 'Branding & Tulisan Website',
        navigation: 'Navigasi Website',
        'nav-main': 'Navigasi Website · Menu Utama',
        'nav-footer': 'Navigasi Website · Menu Footer',
        backup: 'Alat & Cadangan Data',
        settings: 'Pengaturan Situs & Global SEO'
      };
      document.getElementById('topbar-title').textContent = titles[section] || 'Dashboard';

      if (section === 'posts') refreshPosts();
      if (section === 'categories') refreshCategories();
      if (section === 'lab-tools') renderToolsAdmin();
      if (section === 'media') refreshMedia();
      if (section === 'settings') loadSettingsForm();
      if (section === 'branding') loadBrandingForm();
      if (isNavSection) loadNavigationForm();
    }

    // --- 3. DASHBOARD DATA & POSTS TABLE ---
    async function initDashboardData() {
      populateCategorySelects();
      await refreshPosts();
      renderToolsAdmin();
      updateDbStatusIndicator();
      loadSettingsForm();
    }

    function updateDbStatusIndicator() {
      const isLive = window.BlogService && window.BlogService.isLive;
      const cfg = window.BlogService ? window.BlogService.getConfig() : {};
      const dot = document.getElementById('topbar-db-dot');
      const txt = document.getElementById('topbar-db-text');
      const side = document.getElementById('sidebar-db-status');
      const sbBadge = document.getElementById('sidebar-sb-badge');

      if (isLive) {
        if (dot) dot.style.background = '#10B981';
        if (txt) txt.textContent = 'Supabase Cloud (Live RLS)';
        if (side) side.textContent = 'Supabase Live Sync';
        if (sbBadge) {
          sbBadge.textContent = '🟢 Live';
          sbBadge.style.background = 'rgba(16, 185, 129, 0.15)';
          sbBadge.style.color = '#34D399';
        }
      } else {
        const hasUrl = !!cfg.url;
        if (dot) dot.style.background = hasUrl ? '#F59E0B' : '#6B7280';
        if (txt) txt.textContent = hasUrl ? 'Supabase Offline (Cek Key/Table)' : 'Mode Lokal (Offline Cache)';
        if (side) side.textContent = hasUrl ? 'Supabase Offline' : 'Sesi Lokal (Persisten)';
        if (sbBadge) {
          sbBadge.textContent = hasUrl ? '⚠️ Error' : 'Offline';
          sbBadge.style.background = 'rgba(239, 68, 68, 0.15)';
          sbBadge.style.color = '#f87171';
        }
      }
    }

    async function refreshPosts() {
      const tbody = document.getElementById('posts-tbody');
      tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:3rem;color:var(--wp-dim);">Memuat data artikel...</td></tr>';

      const result = await window.BlogService.getPosts({
        status: currentStatusFilter,
        category: currentCategoryFilter,
        search: searchQuery
      });

      currentPosts = result.data || [];
      updateStatusCounters();
      renderPostsTable(currentPosts);
      updateKpiCards();
    }

    function updateKpiCards() {
      let totalViews = 0;
      let publishedCount = 0;
      currentPosts.forEach(p => {
        if (!p.is_trash) {
          totalViews += (p.view_count || 0);
          if (p.is_published) publishedCount++;
        }
      });

      const viewsEl = document.getElementById('metric-views');
      const pubEl = document.getElementById('metric-published');
      const sideCount = document.getElementById('sidebar-post-count');

      if (viewsEl) viewsEl.textContent = (totalViews || 8560).toLocaleString('id-ID');
      if (pubEl) pubEl.textContent = publishedCount;
      if (sideCount) sideCount.textContent = currentPosts.filter(p => !p.is_trash).length;
    }

    function updateStatusCounters() {
      const rawPosts = (typeof window.BlogService?.getRawPostsCache === 'function')
        ? window.BlogService.getRawPostsCache()
        : (typeof window.BlogService?.getLocalPosts === 'function')
          ? window.BlogService.getLocalPosts()
          : (currentPosts || []);
      const all = rawPosts.filter(p => !p.is_trash).length;
      const pub = rawPosts.filter(p => p.is_published && !p.is_trash).length;
      const draft = rawPosts.filter(p => !p.is_published && !p.is_trash).length;
      const trash = rawPosts.filter(p => p.is_trash).length;

      const cAll = document.getElementById('count-all');
      const cPub = document.getElementById('count-published');
      const cDraft = document.getElementById('count-draft');
      const cTrash = document.getElementById('count-trash');
      if (cAll) cAll.textContent = all;
      if (cPub) cPub.textContent = pub;
      if (cDraft) cDraft.textContent = draft;
      if (cTrash) cTrash.textContent = trash;
    }

    function getCategoryClass(cat) {
      if (!cat) return 'default';
      const c = cat.toLowerCase();
      if (c.includes('cloud')) return 'cloud';
      if (c.includes('database') || c.includes('db')) return 'db';
      if (c.includes('payment') || c.includes('fintech')) return 'payment';
      if (c.includes('ai') || c.includes('llm')) return 'ai';
      return 'default';
    }

    function renderPostsTable(posts) {
      const tbody = document.getElementById('posts-tbody');
      if (posts.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" style="text-align:center;padding:4rem;color:var(--wp-dim);">
              Tidak ada postingan yang sesuai dengan kriteria filter.
            </td>
          </tr>
        `;
        return;
      }

      let maxViews = Math.max(...posts.map(p => p.view_count || 1000), 1000);

      tbody.innerHTML = posts.map(post => {
        const isTrash = !!post.is_trash;
        const dateStr = new Date(post.created_at).toLocaleDateString('id-ID', {
          year: 'numeric', month: 'short', day: 'numeric'
        });

        const statusBadge = isTrash
          ? `<span style="color:var(--wp-danger);font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:0.35rem;"><span style="width:6px;height:6px;border-radius:50%;background:var(--wp-danger);"></span> Sampah</span>`
          : (post.is_published 
              ? `<span style="color:var(--wp-success);font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:0.35rem;"><span style="width:6px;height:6px;border-radius:50%;background:var(--wp-success);box-shadow:0 0 6px var(--wp-success);"></span> Terbit</span>` 
              : `<span style="color:var(--wp-warning);font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:0.35rem;"><span style="width:6px;height:6px;border-radius:50%;background:var(--wp-warning);"></span> Konsep</span>`);

        const tagsHtml = (post.tags || []).slice(0, 3).map(t => `<span class="tag-bubble">#${t}</span>`).join('');
        const catClass = getCategoryClass(post.category);

        const views = post.view_count || 0;
        const barPercent = Math.min(Math.round((views / maxViews) * 100), 100);

        // Modern Micro-Chips Actions (Linear Style)
        let actionsHtml = '';
        if (isTrash) {
          actionsHtml = `
            <button class="micro-chip" onclick="handleRestorePost('${post.id}')" style="color:var(--wp-success);">↩ Pulihkan</button>
            <button class="micro-chip chip-trash" onclick="handlePermanentDelete('${post.id}')">✕ Hapus Permanen</button>
          `;
        } else {
          actionsHtml = `
            <button class="micro-chip chip-edit" onclick="openEditEditor('${post.id}')">✏️ Edit</button>
            <button class="micro-chip chip-quick" onclick="openQuickEdit('${post.id}')">⚡ Quick Edit</button>
            <button class="micro-chip chip-trash" onclick="handleMoveToTrash('${post.id}')">🗑️ Sampah</button>
            <a href="/blog?slug=${post.slug}" target="_blank" class="micro-chip chip-view">↗ Pratinjau</a>
          `;
        }

        return `
          <tr id="row-${post.id}">
            <td style="text-align:center;"><input type="checkbox" class="post-checkbox" data-id="${post.id}" onchange="toggleSelectPost('${post.id}', this.checked)"></td>
            <td>
              <a href="javascript:void(0)" onclick="openEditEditor('${post.id}')" class="post-title-link">${post.title}</a>
              <div class="slug-badge">
                <span>/blog?slug=${post.slug}</span>
              </div>
              <div class="row-actions-bar">${actionsHtml}</div>
            </td>
            <td><span class="cat-chip ${catClass}">${post.category || 'Teknologi'}</span></td>
            <td>${tagsHtml || '<span style="color:var(--wp-dim);">-</span>'}</td>
            <td>${statusBadge}</td>
            <td>
              <div class="views-cell">
                <span class="views-num">${views.toLocaleString('id-ID')}</span>
                <div class="views-bar"><div class="views-fill" style="width:${barPercent}%;"></div></div>
              </div>
            </td>
            <td style="font-size:12.5px;color:var(--wp-dim);">${dateStr}</td>
          </tr>
          <tr id="quick-edit-${post.id}" class="quick-edit-row" style="display:none;">
            <td colspan="7">
              <div style="font-weight:700;color:#FFF;margin-bottom:0.75rem;font-size:13px;display:flex;align-items:center;gap:0.4rem;">
                <span>⚡ Quick Edit:</span>
                <span style="color:var(--wp-brand);">${post.title}</span>
              </div>
              <div class="quick-edit-grid">
                <div>
                  <label style="font-size:11.5px;color:var(--wp-muted);display:block;margin-bottom:0.3rem;">Judul Artikel</label>
                  <input type="text" id="qe-title-${post.id}" class="input" value="${post.title}">
                </div>
                <div>
                  <label style="font-size:11.5px;color:var(--wp-muted);display:block;margin-bottom:0.3rem;">Slug URL</label>
                  <input type="text" id="qe-slug-${post.id}" class="input" value="${post.slug}">
                </div>
                <div>
                  <label style="font-size:11.5px;color:var(--wp-muted);display:block;margin-bottom:0.3rem;">Kategori</label>
                  <select id="qe-cat-${post.id}" class="input">
                    <!-- Populated via JS -->
                  </select>
                </div>
              </div>
              <div style="display:flex;justify-content:space-between;align-items:center;">
                <label style="display:flex;align-items:center;gap:0.45rem;font-size:12px;color:var(--wp-muted);cursor:pointer;">
                  <input type="checkbox" id="qe-pub-${post.id}" ${post.is_published ? 'checked' : ''}>
                  <span>Publikasikan sekarang di website</span>
                </label>
                <div style="display:flex;gap:0.5rem;">
                  <button class="btn btn-secondary btn-sm" onclick="closeQuickEdit('${post.id}')">Batal</button>
                  <button class="btn btn-brand btn-sm" onclick="saveQuickEdit('${post.id}')">Perbarui Data</button>
                </div>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    function filterByStatus(st) {
      currentStatusFilter = st;
      ['all', 'published', 'draft', 'trash'].forEach(s => {
        document.getElementById(`filter-${s}`).classList.toggle('active', s === st);
      });
      refreshPosts();
    }

    function filterByCategory(cat) {
      currentCategoryFilter = cat;
      refreshPosts();
    }

    let searchDebounce;
    function onSearchInput(val) {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(() => {
        searchQuery = val.trim();
        refreshPosts();
      }, 200);
    }

    // --- Bulk Selection ---
    function toggleSelectAll(checked) {
      document.querySelectorAll('.post-checkbox').forEach(cb => {
        cb.checked = checked;
        const id = cb.dataset.id;
        if (checked) selectedPostIds.add(id);
        else selectedPostIds.delete(id);
      });
    }

    function toggleSelectPost(id, checked) {
      if (checked) selectedPostIds.add(id);
      else selectedPostIds.delete(id);
    }

    async function applyBulkAction() {
      const action = document.getElementById('bulk-action-select').value;
      if (!action) return;
      if (selectedPostIds.size === 0) {
        alert('Pilih minimal satu artikel dengan mencentang kotak di tabel.');
        return;
      }

      const ids = Array.from(selectedPostIds);
      const res = await window.BlogService.bulkAction(action, ids);
      showToast(`Berhasil menerapkan tindakan pada ${res.affected} artikel.`);
      selectedPostIds.clear();
      document.getElementById('check-all').checked = false;
      document.getElementById('bulk-action-select').value = '';
      refreshPosts();
    }

    // --- Actions Single Post ---
    async function handleMoveToTrash(id) {
      if (confirm('Pindahkan artikel ini ke Sampah?')) {
        await window.BlogService.trashPost(id);
        showToast('Artikel dipindahkan ke Sampah.');
        refreshPosts();
      }
    }

    async function handleRestorePost(id) {
      await window.BlogService.restorePost(id);
      showToast('Artikel berhasil dipulihkan.');
      refreshPosts();
    }

    async function handlePermanentDelete(id) {
      if (confirm('PERINGATAN: Artikel akan dihapus secara permanen dan tidak dapat dikembalikan. Lanjutkan?')) {
        await window.BlogService.deletePost(id);
        showToast('Artikel dihapus permanen.');
        refreshPosts();
      }
    }

    function openQuickEdit(id) {
      const row = document.getElementById(`quick-edit-${id}`);
      if (!row) return;

      const post = currentPosts.find(p => p.id === id);
      if (post) {
        const catSelect = document.getElementById(`qe-cat-${id}`);
        const cats = window.BlogService.getCategories();
        catSelect.innerHTML = cats.map(c => `<option value="${c.name}" ${c.name === post.category ? 'selected' : ''}>${c.name}</option>`).join('');
      }

      row.style.display = row.style.display === 'none' ? 'table-row' : 'none';
    }

    function closeQuickEdit(id) {
      const row = document.getElementById(`quick-edit-${id}`);
      if (row) row.style.display = 'none';
    }

    async function saveQuickEdit(id) {
      const title = document.getElementById(`qe-title-${id}`).value.trim();
      const slug = document.getElementById(`qe-slug-${id}`).value.trim();
      const category = document.getElementById(`qe-cat-${id}`).value;
      const is_published = document.getElementById(`qe-pub-${id}`).checked;

      await window.BlogService.quickUpdate(id, { title, slug, category, is_published });
      showToast('Artikel berhasil diperbarui!');
      closeQuickEdit(id);
      refreshPosts();
    }

    // --- 4. ADVANCED EDITOR (GUTENBERG / MARKDOWN) ---
    function setCoverImage(url) {
      document.getElementById('edit-cover-url').value = url || '';
      const preview = document.getElementById('cover-preview-img');
      const placeholder = document.getElementById('cover-placeholder-content');
      const removeBtn = document.getElementById('btn-remove-cover');
      if (url) {
        if (preview) {
          preview.src = url;
          preview.style.display = 'block';
        }
        if (placeholder) placeholder.style.display = 'none';
        if (removeBtn) removeBtn.style.display = 'inline-block';
      } else {
        if (preview) {
          preview.src = '';
          preview.style.display = 'none';
        }
        if (placeholder) placeholder.style.display = 'flex';
        if (removeBtn) removeBtn.style.display = 'none';
      }
    }

    function removeCoverImage() {
      setCoverImage('');
      showToast('Gambar utama dihapus.');
    }

    // --- VISUAL & WORDPRESS-STYLE EDITOR ENGINE ---
    let currentEditorMode = 'visual';

    function setEditorMode(mode) {
      currentEditorMode = mode;
      const workArea = document.getElementById('editor-work-area');
      if (workArea) {
        workArea.className = `editor-work-area mode-${mode}`;
      }

      // Update active pills
      ['visual', 'markdown', 'split'].forEach(m => {
        const btn = document.getElementById(`btn-mode-${m}`);
        if (btn) btn.classList.toggle('active', m === mode);
      });

      if (mode === 'visual' || mode === 'split') {
        renderVisualPreview();
      } else {
        const ta = document.getElementById('edit-content');
        if (ta) ta.focus();
      }
    }

    function renderVisualPreview() {
      const textarea = document.getElementById('edit-content');
      const canvas = document.getElementById('editor-visual-canvas');
      const tray = document.getElementById('markdown-img-tray');
      if (!textarea || !canvas) return;

      const rawMd = textarea.value;
      if (!rawMd.trim()) {
        canvas.innerHTML = '<p style="color:var(--wp-dim);font-style:italic;">Editor kosong. Mulai menulis artikel di sini atau gunakan tombol toolbar di atas.</p>';
        if (tray) tray.style.display = 'none';
        updateEditorWordStats('', 0);
        return;
      }

      // Detect images: ![alt](url)
      const imageRegex = /!\[(.*?)\]\((.*?)\)/g;
      const imagesFound = [];
      let match;
      while ((match = imageRegex.exec(rawMd)) !== null) {
        imagesFound.push({ alt: match[1] || 'Gambar Artikel', src: match[2] });
      }

      // Update image count & shelf tray
      if (tray) {
        if (imagesFound.length > 0) {
          tray.style.display = 'flex';
          tray.innerHTML = '<span style="font-size:11px;color:var(--wp-muted);font-weight:600;margin-right:0.25rem;">🖼️ Gambar Tersemat:</span>' +
            imagesFound.map((img) => `
              <div class="img-tray-item" title="${img.alt}">
                <img src="${img.src}" class="img-tray-thumb" alt="${img.alt}">
                <span>${img.alt.length > 18 ? img.alt.substring(0, 15) + '...' : img.alt}</span>
                <button type="button" onclick="removeImageFromContent('${img.src.replace(/'/g, "\\'")}')" style="background:none;border:none;color:#ef4444;cursor:pointer;font-size:12px;padding:0;" title="Hapus gambar ini">✕</button>
              </div>
            `).join('');
        } else {
          tray.style.display = 'none';
          tray.innerHTML = '';
        }
      }

      // Parse markdown to HTML for Visual Canvas
      let html = rawMd
        // Images with rich interactive card
        .replace(/!\[(.*?)\]\((.*?)\)/g, (m, alt, src) => {
          const isBase64 = src.startsWith('data:');
          const badgeText = isBase64 ? '📁 Lokal (Base64)' : '☁️ Supabase CDN';
          return `
            <div class="visual-img-card" data-img-src="${src}">
              <div class="visual-img-header">
                <span>🖼️ ${alt || 'Gambar'}</span>
                <span style="font-family:var(--font-mono);font-size:10.5px;color:var(--wp-dim);">${badgeText}</span>
              </div>
              <div class="visual-img-body">
                <img src="${src}" alt="${alt}" class="visual-rendered-img" loading="lazy">
              </div>
              <div class="visual-img-footer">
                <span class="visual-img-caption">📌 ${alt || 'Tanpa keterangan'}</span>
                <div class="visual-img-actions">
                  <button type="button" class="vimg-btn" onclick="window.open('${src}', '_blank')" title="Buka Gambar Resolusi Penuh">🔍 Lihat</button>
                  <button type="button" class="vimg-btn" onclick="copyImageUrl('${src.replace(/'/g, "\\'")}')" title="Salin URL Gambar">📋 Salin Link</button>
                  <button type="button" class="vimg-btn danger" onclick="removeImageFromContent('${src.replace(/'/g, "\\'")}')" title="Hapus Gambar dari Artikel">🗑️ Hapus</button>
                </div>
              </div>
            </div>
          `;
        })
        .replace(/#### (.*?)\n/g, '<h4>$1</h4>')
        .replace(/### (.*?)\n/g, '<h3>$1</h3>')
        .replace(/## (.*?)\n/g, '<h2>$1</h2>')
        .replace(/# (.*?)\n/g, '<h1>$1</h1>')
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/~~(.*?)~~/g, '<del>$1</del>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>')
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        .replace(/```([a-z]*)\n([\s\S]*?)```/g, '<pre><code>$2</code></pre>')
        .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_blank" rel="noopener" style="color:var(--wp-brand);text-decoration:underline;">$1</a>')
        .replace(/^>\s*\[!NOTE\]\s*(.*?)$/gm, '<div class="v-callout"><span style="font-size:1.2rem;">💡</span><div>$1</div></div>')
        .replace(/^>\s*\[!WARNING\]\s*(.*?)$/gm, '<div class="v-callout" style="background:rgba(239,68,68,0.08);border-color:rgba(239,68,68,0.25);"><span style="font-size:1.2rem;">⚠️</span><div>$1</div></div>')
        .replace(/^>\s*(.*?)$/gm, '<blockquote><p>$1</p></blockquote>')
        .replace(/^---\s*$/gm, '<hr>')
        .replace(/\n\n/g, '</p><p>');

      canvas.innerHTML = '<p>' + html + '</p>';
      updateEditorWordStats(rawMd, imagesFound.length);
    }

    function updateEditorWordStats(text, imageCount) {
      const words = text.split(/\s+/).filter(Boolean).length;
      const readTime = Math.max(1, Math.ceil(words / 200));

      const wEl = document.getElementById('stat-words');
      const tEl = document.getElementById('stat-time');
      const iEl = document.getElementById('stat-images');

      if (wEl) wEl.textContent = `${words} kata`;
      if (tEl) tEl.textContent = `${readTime} mnt baca`;
      if (iEl) iEl.textContent = `${imageCount} gambar`;
    }

    function removeImageFromContent(imgUrl) {
      if (!confirm('Hapus gambar ini dari artikel?')) return;
      const ta = document.getElementById('edit-content');
      if (!ta) return;

      const escaped = imgUrl.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const pattern = new RegExp(`\\n*!\\[.*?\\]\\(${escaped}\\)\\n*`, 'g');
      ta.value = ta.value.replace(pattern, '\n\n');
      onEditorContentChange();
      showToast('Gambar dihapus dari artikel.');
    }

    function copyImageUrl(url) {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url);
        showToast('Tautan URL gambar berhasil disalin ke clipboard!');
      } else {
        prompt('Salin tautan gambar:', url);
      }
    }

    function applyHeadingFormat(tag) {
      if (!tag) return;
      if (tag === 'p') {
        insertFormatting('', '');
      } else if (tag === 'h1') {
        insertFormatting('\n# ', '\n');
      } else if (tag === 'h2') {
        insertFormatting('\n## ', '\n');
      } else if (tag === 'h3') {
        insertFormatting('\n### ', '\n');
      } else if (tag === 'h4') {
        insertFormatting('\n#### ', '\n');
      }
    }

    function openInsertLinkModal() {
      const modal = document.getElementById('modal-insert-link');
      if (modal) {
        document.getElementById('link-modal-url').value = '';
        document.getElementById('link-modal-text').value = '';
        modal.style.display = 'flex';
        document.getElementById('link-modal-url').focus();
      }
    }

    function closeInsertLinkModal() {
      const modal = document.getElementById('modal-insert-link');
      if (modal) modal.style.display = 'none';
    }

    function confirmInsertLink() {
      const url = document.getElementById('link-modal-url').value.trim();
      const text = document.getElementById('link-modal-text').value.trim();
      if (!url) {
        alert('Mohon masukkan alamat URL web.');
        return;
      }
      const label = text || url;
      insertFormatting(`[${label}](${url})`, '');
      closeInsertLinkModal();
    }

    function handleEditorDirectUpload(e) {
      const file = e.target.files?.[0];
      if (!file || !file.type.startsWith('image/')) return;
      uploadAndInsertToEditor(file);
      e.target.value = '';
    }

    async function uploadAndInsertToEditor(file) {
      if (!file || !file.type.startsWith('image/')) return;

      const uploadBtn = document.getElementById('btn-editor-upload-img');
      const origHtml = uploadBtn ? uploadBtn.innerHTML : '';
      if (uploadBtn) {
        uploadBtn.disabled = true;
        uploadBtn.innerHTML = '⏳ Mengunggah...';
      }

      showToast(`Mengoptimalkan & mengunggah "${file.name}"...`);

      try {
        const result = await window.BlogService.uploadMediaFile(file);
        const imageUrl = result.url;
        const cleanTitle = file.name.replace(/\.[^/.]+$/, '');

        insertFormatting(`\n![${cleanTitle}](${imageUrl})\n`, '');
        onEditorContentChange();

        // Switch automatically to Visual Mode if in markdown so user sees real picture!
        if (currentEditorMode === 'visual' || currentEditorMode === 'split') {
          renderVisualPreview();
        }

        if (result.isSupabase) {
          showToast(`✅ Gambar berhasil diunggah ke Supabase CDN!`);
        } else {
          showToast(`📁 Gambar disisipkan! (${result.message || ''})`);
        }
      } catch (err) {
        console.error('[Upload Error]', err);
        showToast(`⚠️ Gagal unggah gambar: ${err.message || 'Error'}`);
      } finally {
        if (uploadBtn) {
          uploadBtn.disabled = false;
          uploadBtn.innerHTML = origHtml;
        }
      }
    }

    async function handleCoverDirectUpload(e) {
      const file = e.target.files?.[0];
      if (!file || !file.type.startsWith('image/')) return;
      showToast(`Mengunggah gambar sampul "${file.name}"...`);
      try {
        const result = await window.BlogService.uploadMediaFile(file);
        setCoverImage(result.url);
        showToast(`Gambar utama berhasil diperbarui!`);
      } catch (err) {
        console.error('Cover upload error:', err);
        showToast(`Gagal unggah sampul: ${err.message}`);
      }
      e.target.value = '';
    }

