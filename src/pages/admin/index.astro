    // --- 7. MEDIA LIBRARY & LUXURY GALLERY ENGINE ---
    let currentMediaFilter = '';
    let inspectingMediaId = null;

    function refreshMedia() {
      const media = window.BlogService.getMedia();
      const container = document.getElementById('media-gallery');
      const stats = document.getElementById('media-stats-summary');

      let filtered = media;
      if (currentMediaFilter) {
        filtered = media.filter(m => (m.name || m.title || '').toLowerCase().includes(currentMediaFilter.toLowerCase()));
      }

      if (stats) {
        stats.textContent = `Total ${media.length} berkas media tersimpan · Siap digunakan untuk ilustrasi artikel.`;
      }

      if (filtered.length === 0) {
        container.innerHTML = `
          <div style="grid-column:1/-1;text-align:center;padding:3.5rem;background:var(--wp-surface);border:1px dashed var(--wp-border);border-radius:12px;">
            <div style="font-size:32px;margin-bottom:0.5rem;">🖼️</div>
            <div style="font-size:14px;font-weight:600;color:#FFF;margin-bottom:0.25rem;">Tidak ada berkas media yang cocok</div>
            <p style="font-size:12px;color:var(--wp-dim);">Unggah gambar baru atau gunakan kolom pencarian untuk menemukan aset.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = filtered.map(m => {
        const title = m.name || m.title || 'Berkas Media';
        const ext = title.split('.').pop().toUpperCase();
        const size = m.size || '180 KB';
        const date = m.date || 'Terbaru';

        return `
          <div class="media-card" id="media-card-${m.id}">
            <div class="media-thumb-box" onclick="openInspectModal('${m.id}')">
              <img src="${m.url}" alt="${title}" class="media-thumb-img" loading="lazy">
              <div class="media-overlay-actions" onclick="event.stopPropagation()">
                <button class="media-action-pill" onclick="openInspectModal('${m.id}')" title="Buka Detail">🔍 Detail</button>
                <button class="media-action-pill" onclick="copyMediaMarkdown('${m.url}', '${title}')" title="Salin Kode Markdown">📋 MD</button>
                <button class="media-action-pill" onclick="copyMediaDirectUrl('${m.url}')" title="Salin URL">🔗 URL</button>
                <button class="media-action-pill pill-delete" onclick="deleteMediaDirect('${m.id}')" title="Hapus">🗑️</button>
              </div>
            </div>
            <div class="media-body-info">
              <div class="media-item-title" title="${title}">${title}</div>
              <div class="media-item-sub">
                <span class="format-badge">${ext}</span>
                <span>${size}</span>
                <span>${date}</span>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function onMediaSearch(val) {
      currentMediaFilter = val.trim();
      refreshMedia();
    }

    // --- Drag & Drop & Local File Upload ---
    function handleDragOver(e) {
      e.preventDefault();
      document.getElementById('media-dropzone').classList.add('dragover');
    }
    function handleDragLeave(e) {
      e.preventDefault();
      document.getElementById('media-dropzone').classList.remove('dragover');
    }
    function handleDrop(e) {
      e.preventDefault();
      document.getElementById('media-dropzone').classList.remove('dragover');
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        processUploadFiles(e.dataTransfer.files);
      }
    }

    function handleFileInputChange(e) {
      if (e.target.files && e.target.files.length > 0) {
        processUploadFiles(e.target.files);
        e.target.value = '';
      }
    }

    function processUploadFiles(files) {
      let count = 0;
      Array.from(files).forEach(file => {
        if (!file.type.startsWith('image/')) return;
        const reader = new FileReader();
        const sizeKb = Math.round(file.size / 1024) + ' KB';
        reader.onload = (uploadEvt) => {
          window.BlogService.addMedia({
            name: file.name,
            title: file.name,
            url: uploadEvt.target.result,
            size: sizeKb,
            type: file.type
          });
          count++;
          showToast(`Berhasil mengunggah ${file.name}!`);
          refreshMedia();
        };
        reader.readAsDataURL(file);
      });
    }

