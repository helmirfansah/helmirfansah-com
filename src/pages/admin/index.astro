    function onEditorTitleChange(title) {
      const id = document.getElementById('edit-id').value;
      if (!id) {
        const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        document.getElementById('edit-slug').value = slug;
      }
      calculateSeoScore();
    }

    function onEditorContentChange() {
      renderVisualPreview();
      calculateSeoScore();
      triggerAutoSave();
    }

    function triggerAutoSave() {
      clearTimeout(autoSaveTimer);
      const statusPill = document.getElementById('autosave-status');
      statusPill.textContent = 'Menyimpan draft...';

      autoSaveTimer = setTimeout(() => {
        statusPill.textContent = `● Tersimpan: ${new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })}`;
      }, 1000);
    }

    function insertFormatting(prefix, suffix) {
      const textarea = document.getElementById('edit-content');
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const text = textarea.value;
      const selected = text.substring(start, end);

      const replacement = prefix + selected + suffix;
      textarea.value = text.substring(0, start) + replacement + text.substring(end);
      textarea.focus();
      textarea.setSelectionRange(start + prefix.length, start + prefix.length + selected.length);
      onEditorContentChange();
    }

    // --- 5. LIVE YOAST / RANKMATH STYLE SEO ENGINE ---
    function calculateSeoScore() {
      const title = document.getElementById('edit-title').value.toLowerCase();
      const content = document.getElementById('edit-content').value.toLowerCase();
      const excerpt = document.getElementById('edit-excerpt').value.toLowerCase();
      const kw = document.getElementById('seo-focus-kw').value.trim().toLowerCase();

      let score = 20;

      const ruleTitle = document.getElementById('seo-rule-title');
      const ruleContent = document.getElementById('seo-rule-content');
      const ruleLength = document.getElementById('seo-rule-length');
      const ruleDesc = document.getElementById('seo-rule-desc');

      if (kw && title.includes(kw)) {
        score += 25;
        ruleTitle.style.color = 'var(--wp-success)';
        ruleTitle.textContent = '✓ Kata kunci ada di Judul';
      } else {
        ruleTitle.style.color = 'var(--wp-dim)';
        ruleTitle.textContent = '○ Kata kunci belum ada di Judul';
      }

      if (kw && content.includes(kw)) {
        score += 25;
        ruleContent.style.color = 'var(--wp-success)';
        ruleContent.textContent = '✓ Kata kunci ditemukan di konten';
      } else {
        ruleContent.style.color = 'var(--wp-dim)';
        ruleContent.textContent = '○ Kata kunci belum ada di konten';
      }

      const wordCount = content.split(/\s+/).filter(Boolean).length;
      if (wordCount >= 200) {
        score += 15;
        ruleLength.style.color = 'var(--wp-success)';
        ruleLength.textContent = `✓ Panjang konten (${wordCount} kata) memadai`;
      } else {
        ruleLength.style.color = 'var(--wp-dim)';
        ruleLength.textContent = `○ Konten masih pendek (${wordCount} kata)`;
      }

      if (excerpt.length >= 50) {
        score += 15;
        ruleDesc.style.color = 'var(--wp-success)';
        ruleDesc.textContent = '✓ Ringkasan meta description optimal';
      } else {
        ruleDesc.style.color = 'var(--wp-dim)';
        ruleDesc.textContent = '○ Ringkasan meta masih kurang dari 50 karakter';
      }

      const badge = document.getElementById('seo-score-badge');
      badge.textContent = `${score} / 100`;

      if (score >= 80) {
        badge.style.background = 'rgba(16,185,129,0.15)';
        badge.style.color = 'var(--wp-success)';
      } else if (score >= 50) {
        badge.style.background = 'rgba(245,158,11,0.15)';
        badge.style.color = 'var(--wp-warning)';
      } else {
        badge.style.background = 'rgba(239,68,68,0.15)';
        badge.style.color = 'var(--wp-danger)';
      }
    }

    async function savePostCurrent(publish) {
      const btnPublish = document.getElementById('btn-publish');
      const btnDraft = document.getElementById('btn-save-draft');
      const origPubText = btnPublish ? btnPublish.textContent : 'Terbitkan (Publish)';
      const origDraftText = btnDraft ? btnDraft.textContent : 'Simpan Konsep';

      try {
        const id = document.getElementById('edit-id').value;
        const title = document.getElementById('edit-title').value.trim();
        const slug = document.getElementById('edit-slug').value.trim();
        const content = document.getElementById('edit-content').value || '';
        const excerpt = document.getElementById('edit-excerpt').value.trim();
        const category = document.getElementById('edit-category').value || 'Cloud Migration';
        const tagsInput = document.getElementById('edit-tags').value;
        const tags = tagsInput ? tagsInput.split(',').map(t => t.trim()).filter(Boolean) : [];
        const cover_image = document.getElementById('edit-cover-url') ? document.getElementById('edit-cover-url').value : '';
        const kwEl = document.getElementById('seo-focus-kw');
        const seo_focus_keyword = kwEl ? kwEl.value.trim() : '';

        if (!title) {
          alert('Mohon isi Judul Artikel terlebih dahulu.');
          const titleInput = document.getElementById('edit-title');
          if (titleInput) titleInput.focus();
          return;
        }

        const cleanSlug = slug || window.BlogService.slugify(title);
        const slugInput = document.getElementById('edit-slug');
        if (slugInput) slugInput.value = cleanSlug;

        const wordCount = content.split(/\s+/).filter(Boolean).length;
        const reading_time_minutes = Math.max(1, Math.ceil(wordCount / 200));

        const postData = {
          title,
          slug: cleanSlug,
          content,
          excerpt,
          category,
          tags,
          cover_image,
          featured_image: cover_image,
          seo_focus_keyword,
          meta_description: excerpt,
          is_published: publish,
          reading_time_minutes
        };

        if (btnPublish) { btnPublish.disabled = true; btnPublish.textContent = 'Menyimpan...'; }
        if (btnDraft) { btnDraft.disabled = true; btnDraft.textContent = 'Menyimpan...'; }

        if (id) {
          await window.BlogService.updatePost(id, postData);
          showToast(publish ? 'Artikel berhasil diterbitkan!' : 'Konsep tersimpan.');
        } else {
          await window.BlogService.createPost(postData);
          showToast(publish ? 'Artikel baru telah terbit!' : 'Konsep artikel dibuat.');
        }

        switchNav('posts');
        await refreshPosts();
      } catch (err) {
        console.error('Error saat menyimpan artikel:', err);
        alert('Gagal menyimpan artikel: ' + (err.message || err));
      } finally {
        if (btnPublish) { btnPublish.disabled = false; btnPublish.textContent = origPubText; }
        if (btnDraft) { btnDraft.disabled = false; btnDraft.textContent = origDraftText; }
      }
    }

