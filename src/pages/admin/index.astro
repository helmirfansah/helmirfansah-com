    function saveToolForm(e) {
      e.preventDefault();
      if (!window.BlogService) return;

      const id = document.getElementById('tool-form-id').value.trim();
      const name = document.getElementById('tool-form-name').value.trim();
      const icon = document.getElementById('tool-form-icon').value.trim() || '⚙️';
      const category = document.getElementById('tool-form-category').value;
      const badge = document.getElementById('tool-form-badge').value.trim();
      let slug = document.getElementById('tool-form-slug').value.trim();
      if (!slug.startsWith('/')) slug = '/' + slug;

      const target_keyword = document.getElementById('tool-form-keyword').value.trim();
      const meta_description = document.getElementById('tool-form-meta-desc').value.trim();
      const description = document.getElementById('tool-form-desc').value.trim();
      const is_active = document.getElementById('tool-form-active').checked;

      const toolPayload = {
        name,
        icon,
        category,
        badge,
        slug,
        target_keyword,
        meta_description,
        description,
        is_active
      };

      if (id) {
        toolPayload.id = id;
      }

      window.BlogService.saveTool(toolPayload);
      closeToolModal();
      showToast(id ? 'Tool berhasil diperbarui & disimpan!' : 'Tool baru berhasil ditambahkan!');
      renderToolsAdmin();
    }

