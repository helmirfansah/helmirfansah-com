    function runSimCalc(type) {
      if (type === 'affiliate') {
        const views = parseFloat(document.getElementById('sim-aff-views').value) || 0;
        const ctr = (parseFloat(document.getElementById('sim-aff-ctr').value) || 0) / 100;
        const cvr = (parseFloat(document.getElementById('sim-aff-cvr').value) || 0) / 100;
        const aov = parseFloat(document.getElementById('sim-aff-aov').value) || 0;
        const comm = (parseFloat(document.getElementById('sim-aff-comm').value) || 0) / 100;

        const clicks = Math.round(views * ctr);
        const orders = Math.round(clicks * cvr);
        const gmv = orders * aov;
        const cuan = Math.round(gmv * comm);
        const epc = clicks > 0 ? Math.round(cuan / clicks) : 0;

        const fmt = (n) => new Intl.NumberFormat('id-ID').format(n);
        document.getElementById('sim-aff-res-cuan').textContent = 'Rp ' + fmt(cuan);
        document.getElementById('sim-aff-res-gmv').textContent = 'Rp ' + fmt(gmv);
        document.getElementById('sim-aff-res-clicks').textContent = fmt(clicks) + ' klik (' + fmt(orders) + ' order)';
        document.getElementById('sim-aff-res-epc').textContent = 'Rp ' + fmt(epc) + ' / klik';
      } else if (type === 'er') {
        const followers = parseFloat(document.getElementById('sim-er-followers').value) || 0;
        const likes = parseFloat(document.getElementById('sim-er-likes').value) || 0;
        const comments = parseFloat(document.getElementById('sim-er-comments').value) || 0;
        const shares = parseFloat(document.getElementById('sim-er-shares').value) || 0;

        const totalInteractions = likes + comments + shares;
        const er = followers > 0 ? ((totalInteractions / followers) * 100) : 0;

        let tier = 'Nano Creator';
        let rate = 'Rp 150.000 - Rp 600.000';
        if (followers >= 200000) { tier = 'Macro Creator'; rate = 'Rp 6.500.000+'; }
        else if (followers >= 50000) { tier = 'Mid-Tier Creator'; rate = 'Rp 1.500.000 - Rp 6.500.000'; }
        else if (followers >= 10000) { tier = 'Micro Creator'; rate = 'Rp 500.000 - Rp 2.500.000'; }

        let statusText = '● Kinerja Rata-rata';
        let statusColor = '#38BDF8';
        if (er >= 6) { statusText = '🔥 Sangat Tinggi (Viral)'; statusColor = '#10B981'; }
        else if (er >= 3.5) { statusText = '● Sehat & Kinerja Baik'; statusColor = '#34D399'; }
        else if (er < 1.5) { statusText = '⚠️ Butuh Peningkatan'; statusColor = '#F59E0B'; }

        document.getElementById('sim-er-res-score').textContent = er.toFixed(2) + '%';
        const stEl = document.getElementById('sim-er-res-status');
        stEl.textContent = statusText;
        stEl.style.color = statusColor;
        document.getElementById('sim-er-res-tier').textContent = tier;
        document.getElementById('sim-er-res-rate').textContent = rate;
      }
    }

