    function updateToolFormActiveLabel(isChecked) {
      const label = document.getElementById('tool-form-active-label');
      if (label) {
        label.textContent = isChecked ? '🟢 Aktif (Live)' : '⚪ Nonaktif (Disembunyikan)';
        label.style.color = isChecked ? '#10B981' : '#F87171';
      }
