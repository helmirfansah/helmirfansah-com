      document.getElementById('inspect-type').textContent = item.type || 'image/jpeg';
      document.getElementById('inspect-date').textContent = item.date || 'Terbaru';
      document.getElementById('inspect-url-input').value = item.url;
      document.getElementById('inspect-md-input').value = `![${title}](${item.url})`;

      document.getElementById('inspect-delete-btn').onclick = () => deleteMediaDirect(id);
      document.getElementById('modal-media-inspect').style.display = 'flex';
